                                       <xs:annotation>
                                          <xs:documentation>Mit diesem Element wird die ID der zu beendenden Maßnahme übermittelt.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                 </xs:sequence>
                              </xs:complexType>
                           </xs:element>
                           <xs:element name="pepAnforderung">
                              <xs:complexType>
                                 <xs:sequence>
                                    <xs:element name="verfahrensID" type="din91379:datatypeC">
                                       <xs:annotation>
                                          <xs:documentation>Mit diesem Element wird die Verfahrensnummer übermittelt, unter welcher das Amtshilfeersuchen bei der aufgeforderten Stelle geführt wird.</xs:documentation>
                                       </xs:annotation>
