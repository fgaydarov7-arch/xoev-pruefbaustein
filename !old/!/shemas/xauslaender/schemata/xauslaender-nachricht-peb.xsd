   <xs:element name="PEB.Beendigung.189909">
      <xs:annotation>
         <xs:appinfo>
            <title>Beendingung eines laufenden Teil- oder Gesamtverfahrens</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht kann eine ID-Maßnahme, eine PEP-Anforderung oder das Gesamtverfahren beendet werden. Bevor das Gesamtverfahren beendet werden kann, müssen bereits initiierte ID-Maßnahmen oder PEPBeantragungen vorher beendet worden sein.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:PEB.Basisnachricht">
               <xs:sequence>
                  <xs:element name="person" type="xauslaender:PEB.Person">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element werden Daten der betroffenen Person übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="beenden">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element sind die ID der zu beendenden Teilschritte bzw. des Gesamtverfahrens anzugeben.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:choice>
                           <xs:element name="verfahren" type="din91379:datatypeC">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element wird die Verfahrensnummer des zu beendenden Verfahrens übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="massnahme">
                              <xs:complexType>
                                 <xs:sequence>
                                    <xs:element name="verfahrensID" type="din91379:datatypeC">
