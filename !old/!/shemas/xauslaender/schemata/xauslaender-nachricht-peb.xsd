<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:xauslaender="http://www.osci.de/xauslaender2611"
           xmlns:bn-uq-g2g="http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1"
           xmlns:din91379="urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08"
           xmlns:xiaa="http://www.osci.de/xinneres/auslandsanschrift/5"
           xmlns:xian="http://www.osci.de/xinneres/allgemeinername/4"
           xmlns:xiaz="http://www.osci.de/xinneres/azrnummer/3"
           xmlns:xida="http://www.osci.de/xinneres/datum/2"
           xmlns:xipa="http://www.osci.de/xinneres/postanschrift/5"
           targetNamespace="http://www.osci.de/xauslaender2611"
           version="26.11"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">
   <xs:annotation>
      <xs:appinfo>
         <standard>
            <nameLang>XAusländer</nameLang>
            <nameKurz>XAusländer</nameKurz>
            <nameTechnisch>xinneres.xauslaender</nameTechnisch>
            <kennung>urn:xoev-de:kosit:standard:xinneres.xauslaender</kennung>
            <beschreibung>Das Fachmodul XAusländer des Standards XInneres beschreibt die Datenübermittlung im Ausländerwesen.</beschreibung>
         </standard>
         <versionStandard>
            <version>26.11</version>
            <versionXOEVProfil>3.0.3</versionXOEVProfil>
            <versionXOEVHandbuch>2.4</versionXOEVHandbuch>
            <versionXGenerator>3.0.1</versionXGenerator>
            <versionModellierungswerkzeug>19.0 SP4</versionModellierungswerkzeug>
            <nameModellierungswerkzeug>MagicDraw</nameModellierungswerkzeug>
         </versionStandard>
      </xs:appinfo>
   </xs:annotation>
   <xs:include schemaLocation="xauslaender-allgemeine-datentypen.xsd"/>
   <xs:import schemaLocation="http://www.osci.de/xinneres/allgemeinername/4/xinneres-name.xsd"
              namespace="http://www.osci.de/xinneres/allgemeinername/4"/>
   <xs:import schemaLocation="http://www.osci.de/xinneres/auslandsanschrift/5/xinneres-auslandsanschrift.xsd"
              namespace="http://www.osci.de/xinneres/auslandsanschrift/5"/>
   <xs:import schemaLocation="http://www.osci.de/xinneres/azrnummer/3/xinneres-azrnummer.xsd"
              namespace="http://www.osci.de/xinneres/azrnummer/3"/>
   <xs:import schemaLocation="http://www.osci.de/xinneres/datum/2/xinneres-datum.xsd"
              namespace="http://www.osci.de/xinneres/datum/2"/>
   <xs:import schemaLocation="http://www.osci.de/xinneres/postanschrift/5/xinneres-postanschrift.xsd"
              namespace="http://www.osci.de/xinneres/postanschrift/5"/>
   <xs:import schemaLocation="http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1/xoev-basisnachricht-unqualified-g2g_1.1.xsd"
              namespace="http://xoev.de/schemata/basisnachricht/unqualified/g2g/1_1"/>
   <xs:import schemaLocation="https://xoev.de/schemata/din/91379/2022-08/din-norm-91379-datatypes.xsd"
              namespace="urn:xoev-de:kosit:xoev:datentyp:din-91379_2022-08"/>
   <xs:complexType name="PEB.Anhoerung">
      <xs:annotation>
         <xs:appinfo>
            <title>Details Anhörung</title>
         </xs:appinfo>
         <xs:documentation>Mit diesem Datentyp wird mitgeteilt, dass eine Anhörung geplant ist.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="datumDerAnhoerung" type="xida:Tagesdatum">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird das Datum mitgeteilt, zu dem die Anhörung geplant ist.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="uhrzeitDerAnhoerung" minOccurs="0" type="xs:time">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird die Uhrzeit mitgeteilt, zu dem die Anhörung geplant ist.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="zwangsweise" type="xs:boolean">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird mitgeteilt, ob die Person zwangsweise vorgeführt wird.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="bemerkungZurPerson" minOccurs="0" type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird eine Bemerkung zur Person mitgeteilt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="anschrift"
                     minOccurs="0"
                     type="xipa:PostalischeInlandsanschrift">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird die Anschrift des Anhörungsortes übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="behoerdenkennzeichen" minOccurs="0" type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird das Behördenkennzeichen übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="PEB.Ansprechpartner">
      <xs:annotation>
         <xs:appinfo>
            <title>Ansprechpartner</title>
         </xs:appinfo>
         <xs:documentation>Mit diesem Datentyp werden Informationen zu einem Ansprechpartner innerhalb einer Behörde übermittelt.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="geschaeftszeichen" minOccurs="0" type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>Dieses Element bezeichnet das Merkmal, das den Ansprechpartner für den jeweiligen Sachverhalt identifiziert.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="familienname" type="din91379:datatypeC"/>
         <xs:element name="vorname" minOccurs="0" type="din91379:datatypeC"/>
         <xs:element name="kontaktdaten"
                     maxOccurs="unbounded"
                     type="xauslaender:Kommunikation"/>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="PEB.Basisnachricht">
      <xs:annotation>
         <xs:appinfo>
            <title>Basisnachricht</title>
         </xs:appinfo>
         <xs:documentation>Mit diesem Datentyp werden die Daten des Nachrichtenkopfs für alle Nachrichten im Kontext der Passersatzbeschaffung übermittelt.</xs:documentation>
      </xs:annotation>
      <xs:complexContent>
         <xs:extension base="xauslaender:Nachricht.G2G.XA.erweitert"/>
      </xs:complexContent>
   </xs:complexType>
   <xs:complexType name="PEB.Dokument">
      <xs:annotation>
         <xs:appinfo>
            <title>Dokumentenanhang</title>
         </xs:appinfo>
         <xs:documentation>Mit diesem Datentyp wird ein Dokument übermittelt.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="dokument" type="xs:base64Binary">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird das Dokument übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="dokumententyp" type="xauslaender:Code.PEB.Dokumentformat">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird das Format des Dokumentes übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="PEB.DokumentUndBezeichnung">
      <xs:annotation>
         <xs:appinfo>
            <title>Dokumentenanhang erweitert</title>
         </xs:appinfo>
         <xs:documentation>Mit diesem Datentyp wird ein Dokument inkl. Bezeichnung übermittelt.</xs:documentation>
      </xs:annotation>
      <xs:complexContent>
         <xs:extension base="xauslaender:PEB.Dokument">
            <xs:sequence>
               <xs:element name="bezeichnung" type="din91379:datatypeC">
                  <xs:annotation>
                     <xs:documentation>Mit diesem Element wird die vom Eingabeverfahren vergebene Bezeichnung des Dokumentes übermittelt, die zur Orientierung über den Inhalt des Dokumentes geeignet ist.</xs:documentation>
                  </xs:annotation>
               </xs:element>
            </xs:sequence>
         </xs:extension>
      </xs:complexContent>
   </xs:complexType>
   <xs:complexType name="PEB.Flugreisedaten">
      <xs:annotation>
         <xs:appinfo>
            <title>Flugreisedaten</title>
         </xs:appinfo>
         <xs:documentation>Mit diesem Datentyp werden Flugreisedaten übermittelt.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="abflugzeit" type="xs:time">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird die Abflugzeit des ersten bzw. alleinigen Flugs übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="zielflughafen" type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird der Zielflughafen des letzten bzw. alleinigen Flugs übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="abflugFlughafen" type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird der Abflugflughafen des ersten bzw. alleinigen Flugs übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="flugnummer" type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird die Flugnummer des ersten bzw. alleinigen Flugs übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="via" minOccurs="0" maxOccurs="2">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird der via-Flughafen, die An- und Abflugzeit am via-Flughafen und die Flugnummer des Anschlussfluges übermittelt.</xs:documentation>
            </xs:annotation>
            <xs:complexType>
               <xs:sequence>
                  <xs:element name="viaFlughafen" type="din91379:datatypeC">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird der Flughafen übermittelt, über den der Anschlussflug ausgeführt wird.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="viaAnkunftszeit" type="xs:time">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird die Ankunftszeit des Zubringerfluges übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="viaAbflugzeit" type="xs:time">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird die Abflugzeit des Anschlussflugs übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="viaFlugnummer" type="din91379:datatypeC">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird die Flugnummer des Anschlussflugs übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:complexType>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="PEB.Haft">
      <xs:annotation>
         <xs:appinfo>
            <title>Haft</title>
         </xs:appinfo>
         <xs:documentation>Mit diesem Datentyp werden Angaben zu einem Haftaufenthalt übermittelt.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="haftID" type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird eine (interne) ID übermittelt, die vom Autor festgelegt worden ist, damit spätere Aktualisierungen zugeordnet werden können.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="haftart" type="xauslaender:Code.PEB.Haftart"/>
         <xs:element name="haftbeginn" minOccurs="0" type="xida:Tagesdatum"/>
         <xs:element name="voraussichtlichesHaftendeLautVollstreckungsbeschluss"
                     minOccurs="0"
                     type="xida:Tagesdatum">
            <xs:annotation>
               <xs:documentation>In diesem Element wird das voraussichtliche Haftende laut Vollstreckungsbeschluss übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="tatsaechlichesHaftende" minOccurs="0" type="xida:Tagesdatum">
            <xs:annotation>
               <xs:documentation>In diesem Element wird das tatsächliche Haftende übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="haftendeNach456aStPO" minOccurs="0" type="xida:Tagesdatum">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird der Zeitpunkt übermittelt, ab dem eine Haftentlassung mit dem Ziel der Abschiebung möglich ist. Dieses Element ist nur zu übermitteln, wenn die Zustimmung der Staatsanwaltschaft zur Haftentlassung vorliegt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="jva" minOccurs="0" type="xauslaender:Code.XJustiz.JVA">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird der Behördenschlüssel der JVA mitgeteilt, in der der Betroffene inhaftiert ist.</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="PEB.IDMassnahme">
      <xs:annotation>
         <xs:appinfo>
            <title>ID-Maßnahme</title>
         </xs:appinfo>
         <xs:documentation>Mit diesem Datentyp können erfolgte Identitätsklärungsmaßnahmen übermittelt werden.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="massnahmenArt" type="xauslaender:Code.PEB.Massnahmenart">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird die Art der Maßnahme mitgeteilt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="datumDerMassnahmendurchfuehrung" type="xida:Tagesdatum">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird das Datum mitgeteilt, zu dem die Maßnahmendurchführung geplant ist.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="statusDerAnhoerung"
                     minOccurs="0"
                     type="xauslaender:Code.PEB.StatusDerAnhoerung">
            <xs:annotation>
               <xs:documentation>Im Falle einer Anhörung wird mit diesem Element der Status der Anhörung übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="ergebnis" type="xauslaender:Code.PEB.Massnahmenergebnis">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird das Ergebnis der Identitätsklärung übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="ergebnisVom" type="xida:Tagesdatum">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird übermittelt, an welchem Datum das Ergebnis eingegangen ist.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="bemerkung"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>Mit diesem Element werden Bemerkungen zur Identitätsklärung übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="aktenzeichenHKL" minOccurs="0" type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird das Aktenzeichen des Herkunftslands übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="aktenzeichenAntwort" minOccurs="0" type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird das Aktenzeichen der Antwort übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="PEB.Person">
      <xs:annotation>
         <xs:appinfo>
            <title>Angaben zur Person</title>
         </xs:appinfo>
         <xs:documentation>Mit diesem Datentyp wird die Person identifiziert, für die ein Passeratzpapier beschafft werden soll.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="azrnummer" type="xiaz:AZRNummer"/>
         <xs:element name="vorname" type="xian:AllgemeinerName"/>
         <xs:element name="nachname" type="xian:AllgemeinerName"/>
         <xs:element name="geburt" type="xauslaender:Geburt"/>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="PEB.Sicherheitsbezug">
      <xs:annotation>
         <xs:appinfo>
            <title>Sicherheitsbezug</title>
         </xs:appinfo>
         <xs:documentation>Mit diesem Datentyp wird das Priorisierungsmodell zur Beschaffung eines Heimreisedokumentes berücksichtigt.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="gefaehrder" type="xs:boolean">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird mitgeteilt, ob die betroffene Person ein Gefährder ist oder nicht.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="strafrechtlichInErscheinungGetreten"
                     minOccurs="0"
                     type="xs:boolean">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird mitgeteilt, ob die Person nicht unerheblich strafrechtlich in Erscheinung getreten ist (wobei eine rechtskräftige Verurteilung nicht zwingend vorliegen muss).</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="abstrakteGefaehrdung" minOccurs="0" type="xs:boolean">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird mitgeteilt, ob von einer Person eine abstrakte oder konkrete Gefährdung für die öffentliche Sicherheit ausgeht.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="organisierteKriminalitaet" minOccurs="0" type="xs:boolean">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird mitgeteilt, ob die Person im Rahmen von organisierter Kriminalität in Erscheinung getreten ist.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="bemerkung" minOccurs="0" type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>Mit diesem Element können Angaben konkretisiert werden.</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="PEB.Straftaten">
      <xs:annotation>
         <xs:appinfo>
            <title>Straftaten</title>
         </xs:appinfo>
         <xs:documentation>Mit diesem Datentyp werden Angaben zu weiteren Straftaten oder Ermittlungsverfahren übermittelt.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="bzrAuszug" minOccurs="0" type="xauslaender:PEB.Dokument">
            <xs:annotation>
               <xs:documentation>Mit diesem Element werden Angaben zu weiteren Straftaten oder Ermittlungsverfahren übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="weiterePolizeilicheErkenntnisse"
                     minOccurs="0"
                     type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>Mit diesem Element werden weitere polizeiliche Erkenntnisse und/oder Ermittlungsverfahren mitgeteilt, sofern welche vorliegen.</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="PEB.Unterlage">
      <xs:annotation>
         <xs:appinfo>
            <title>Angaben zur Unterlage</title>
         </xs:appinfo>
         <xs:documentation>Mit diesem Datentyp werden Angaben zu einer Unterlage mitgeteilt.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="dokumentArt" type="xauslaender:Code.PEB.Dokumentenart">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird die Art des Dokuments übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="dokumentSonstiges" minOccurs="0" type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>Dieses Element ist zur Übermittlung der Bezeichnung/Art des Dokuments zu verwenden, sofern als Schlüssel im Element dokumentArt Sonstiges ausgewählt wurde.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="nummer" minOccurs="0" type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird die Nummer des Dokuments übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="ausgestelltAm" minOccurs="0" type="xida:Tagesdatum">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird das Datum der Ausstellung des Dokuments mitgeteilt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="gueltigBis" minOccurs="0" type="xida:Tagesdatum">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird das Gültigkeitsdatum des Dokuments mitgeteilt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="ausstellenderStaat" type="xauslaender:AngabenZumStaat">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird der Staat mitgeteilt, in dem das Dokument ausgestellt worden ist.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="ausstellendeBehoerde" minOccurs="0" type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>Dieses Element übermittelt die ausstellende ausländische oder inländische Behörde.</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="PEB.UnterlageInklDokument">
      <xs:annotation>
         <xs:appinfo>
            <title>Angaben zur Unterlage inkl. Kopie der Unterlage</title>
         </xs:appinfo>
         <xs:documentation>Mit diesem Datentyp werden Angaben zu einer Unterlage inkl. einer Kopie des Dokuments übermittelt.</xs:documentation>
      </xs:annotation>
      <xs:complexContent>
         <xs:extension base="xauslaender:PEB.Unterlage">
            <xs:sequence>
               <xs:element name="dokument" minOccurs="0" type="xauslaender:PEB.Dokument">
                  <xs:annotation>
                     <xs:documentation>Mit diesem Element wird digitale Fassung eines Dokuments übermittelt.</xs:documentation>
                  </xs:annotation>
               </xs:element>
            </xs:sequence>
         </xs:extension>
      </xs:complexContent>
   </xs:complexType>
   <xs:complexType name="PEB.WeiteresFamilienmitglied">
      <xs:annotation>
         <xs:appinfo>
            <title>Weiteres Familienmitglied</title>
         </xs:appinfo>
         <xs:documentation>Mit diesem Datentyp werden Angaben zu einem weiteren Familienmitglied übermittelt.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="azrnummer" minOccurs="0" type="xiaz:AZRNummer"/>
         <xs:element name="verwandtschaftsgrad"
                     type="xauslaender:Code.PEB.Verwandtschaftsgrad">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird die Art der verwandtschaftlichen Beziehung zur Referenzperson übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="vorname" type="xian:AllgemeinerName"/>
         <xs:element name="nachname" type="xian:AllgemeinerName"/>
         <xs:element name="geburt" type="xauslaender:Geburt"/>
         <xs:element name="staatsangehoerigkeit"
                     minOccurs="0"
                     maxOccurs="4"
                     type="xauslaender:AngabenZumStaat"/>
         <xs:element name="letzterBekannterAufenthalt" minOccurs="0">
            <xs:complexType>
