# XÖV-Prüfbaustein — Umgebungsvariablen
#
# Dieses Projekt ist vollständig offline-fähig und benötigt keine
# externen Dienste, API-Schlüssel oder Datenbankverbindungen.
#
# Kopieren Sie diese Datei nach .env und passen Sie die Werte an:
#   cp .env.example .env

# ─── Backend (FastAPI) ────────────────────────────────────────────────────────

# Port, auf dem der Uvicorn-Server lauscht
BACKEND_PORT=8000

# Host-Bindung (0.0.0.0 für Netzwerkzugriff, 127.0.0.1 für lokalen Betrieb)
BACKEND_HOST=127.0.0.1

# Maximale Upload-Größe in Bytes (Standard: 50 MB = 52428800)
MAX_UPLOAD_BYTES=52428800

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────

# Basis-URL des Backends (muss mit BACKEND_HOST und BACKEND_PORT übereinstimmen)
# Hinweis: Diese Variable muss in frontend/.env gesetzt werden, nicht hier.
# VITE_API_BASE_URL=http://127.0.0.1:8000
