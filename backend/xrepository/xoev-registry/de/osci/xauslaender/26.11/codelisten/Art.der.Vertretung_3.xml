      <Description>
         <xoev-cl-4:shortName>Art.der.Vertretung</xoev-cl-4:shortName>
         <xoev-cl-4:codelistDescription>Beschreibt die Art der Vertretung.</xoev-cl-4:codelistDescription>
         <xoev-cl-4:agencyShortName>KoSIT</xoev-cl-4:agencyShortName>
         <xoev-cl-4:validFrom>2026-11-01</xoev-cl-4:validFrom>
