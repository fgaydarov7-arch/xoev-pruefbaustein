   <SimpleCodeList>
      <Row>
         <Value ColumnRef="Schluessel">
            <SimpleValue>01</SimpleValue>
         </Value>
         <Value ColumnRef="Wert">
            <SimpleValue>ein sorgeberechtigter Elternteil ist zum Zeitpunkt des Zugangs der Anzeige beim Bundesamt im Besitz eines Aufenthaltstitels, der nicht auf § 25 Abs. 5 AufenthG beruht</SimpleValue>
         </Value>
      </Row>
      <Row>
