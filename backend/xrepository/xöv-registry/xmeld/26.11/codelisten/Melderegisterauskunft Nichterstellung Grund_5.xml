            <SimpleValue>01</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Die Angaben zum gewerblichen Zweck in der Anfrage sind fehlerhaft.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="key">
            <SimpleValue>04</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Die zu protokollierenden Daten sind nicht vollständig.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="key">
            <SimpleValue>05</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Der Gemeindename, der Amtliche Gemeindeschlüssel oder die Straße innerhalb der Gemeinde existiert nicht.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="key">
            <SimpleValue>06</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Die Berechtigung für diese Einzelanfrage fehlt oder ist nicht ausreichend.</SimpleValue>
         </Value>
      </Row>
      <Row>
