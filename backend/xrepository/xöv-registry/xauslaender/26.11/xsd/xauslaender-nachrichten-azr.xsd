               <xs:documentation>Mit diesem Element wird die Behördenkennung der Behörde übermittelt, die den Sachverhalt gemeldet hat.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="aktenzeichenMeldendeBehoerde"
                     minOccurs="0"
                     type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird das Aktenzeichen zur Maßnahme übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="erlassendeBehoerde"
                     minOccurs="0"
                     type="xauslaender:AZR.Behoerdenkennzeichen">
            <xs:annotation>
               <xs:documentation>Dieses Element übermittelt die Behördenkennung der erlassenden Behörde. Das Attribut wird nur genutzt, wenn meldende und erlassende Behörde voneinander abweichen. Im Falle einer Freiheitsentziehung wird hier das Behördenkennzeichen des anordnenden Gerichts übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="dokumentMetadaten"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="xauslaender:AZR.DokumentMetadaten"/>
