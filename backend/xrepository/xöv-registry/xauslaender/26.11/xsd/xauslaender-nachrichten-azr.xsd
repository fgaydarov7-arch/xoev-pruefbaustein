   <xs:element name="VonAZR.AZRBestaetigungDokument.090097">
      <xs:annotation>
         <xs:appinfo>
            <autor>Ausländerzentralregister (kein Präfix festgelegt)</autor>
            <leser>Kommunikationspartner des AZR nach § 22 AZRG (kein Präfix festgelegt)</leser>
            <rechtsgrundlage>§ 6 AZRG</rechtsgrundlage>
            <title>AZR-Bestätigungsnachricht für Dokumente</title>
         </xs:appinfo>
         <xs:documentation>Die Bestätigung enthält im Falle der Speicherung als Rückmeldung zu einer Dokumentmeldung die vom AZR generierte ID zum Dokument und ggf. Hinweise zur Verarbeitung. Im anderen Falle wird mit dieser Nachricht die Löschung bestätigt.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Nachricht.G2G.XA.VonAZR">
               <xs:sequence>
                  <xs:element name="dokumentId" minOccurs="0" type="din91379:datatypeC">
                     <xs:annotation>
                        <xs:documentation>Dieses Element enthält die ID des Dokuments.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="referenzAufSachverhalt.id"
                              minOccurs="0"
                              type="xauslaender:ReferenzId">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird die Referenz-ID des Sachverhalts übermittelt, dem das Dokument zugeordnet ist.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:any minOccurs="0"
                          maxOccurs="unbounded"
                          namespace="http://www.osci.de/xauslaender2611/azr-erweiterung"
                          processContents="lax"/>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
