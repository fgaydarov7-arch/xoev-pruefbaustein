               <xs:sequence>
                  <xs:element name="trefferliste">
                     <xs:annotation>
                        <xs:documentation>Dieses Element enthält die Ergebnisse zu einer Personenanfrage, abhängig von der Art der Anfrage.</xs:documentation>
