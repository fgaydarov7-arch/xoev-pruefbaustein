   <xs:complexType name="AZR.Aberkennungsverfahren.Auskunft">
      <xs:annotation>
         <xs:appinfo>
            <title>Aberkennungsverfahren</title>
         </xs:appinfo>
         <xs:documentation>Dieses Element enthält die Angaben zur Prüfung, Einleitung und Ablehnung eines Aberkennungsverfahrens zu einem zuerkannten Schutzstatus (Asylberechtigter, Flüchtlingseigenschaft, subsidiärer Schutz, Abschiebungsverbote).</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="aberkennungsverfahrenArt"
                     type="xauslaender:Code.AZR.AberkennungsverfahrenArt">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird die Art des Aberkennungsverfahrens übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="ereignisdatum" minOccurs="0" type="xida:Tagesdatum">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird ein gültiges Ereignisdatum zum Sachverhalt Aberkennungsverfahren übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="meldendeBehoerde"
                     minOccurs="0"
                     type="xauslaender:AZR.Behoerdenkennzeichen">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird die Behördenkennung der Behörde übermittelt, die den Sachverhalt gemeldet hat.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="geschaeftszeichen" minOccurs="0" type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>Das mit diesem Element übermittelte Geschäftszeichen stammt vom BAMF.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="letzteAenderung" minOccurs="0" type="xida:Tagesdatum">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird das Datum des letzten schreibenden Zugriffs übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="referenz.id" type="xauslaender:ReferenzId">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird die Referenz-ID zur Identifizierung des betreffenden Sachverhalts innerhalb des Datensatzes übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:any minOccurs="0"
                 maxOccurs="unbounded"
                 namespace="http://www.osci.de/xauslaender2611/azr-erweiterung"
                 processContents="lax"/>
      </xs:sequence>
   </xs:complexType>
