   <xs:element name="AnAZR.AZRDokumentmeldung.090012">
      <xs:annotation>
         <xs:appinfo>
            <autor>Kommunikationspartner des AZR nach § 22 AZRG (kein Präfix festgelegt)</autor>
            <leser>Ausländerzentralregister (kein Präfix festgelegt)</leser>
            <rechtsgrundlage>§ 6 AZRG</rechtsgrundlage>
            <title>AZR-Dokumentmeldung</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht wird ein Dokument übermittelt.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Nachricht.G2G.XA.AnAZR">
               <xs:sequence>
                  <xs:element name="aenderungsArt" type="xauslaender:Code.AZR.ArtDerAenderung">
                     <xs:annotation>
                        <xs:documentation>Dieses Element legt die Änderungsart der Meldung in der Kommunikation mit dem AZR fest. Es sind nur die Änderungsarten Zuspeicherung und Löschung zulässig. Für die Zuspeicherung sind folgende optionale Elemente zu befüllen: dokument, datenformat, referenzAufSachverhalt.id und ggf. notizen Für die Löschung ist folgendes Element zu befüllen: dokumentId</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="azrNummer" type="xiaz:AZRNummer"/>
                  <xs:element name="notizen" minOccurs="0" type="din91379:datatypeC">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element kann eine Notiz bei Verfügungstexten übermittelt werden, die der Sachbearbeitung im Bundesverwaltungsamt angezeigt wird. Für andere Dokumente findet die Notiz keine Verwendung.Implementierungshinweis:Meldungen von Verfügungstexten mit Notizen, die mehr als 2000 Zeichen lang sind, werden seitens des AZR mit Fehler abgewiesen.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="dokument" minOccurs="0" type="xs:base64Binary">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird das Dokument übermittelt. Die Größe des Dokuments vor der base64-Kodierung darf 10 MB nicht überschreiten.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="dokumentTyp" type="xauslaender:Code.AZR.Dokumenttyp">
                     <xs:annotation>
                        <xs:documentation>Dieses Element übermittelt die Art des Dokumentes.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="datenformat"
                              minOccurs="0"
                              type="xauslaender:Code.AZR.Dokumentenformat">
                     <xs:annotation>
                        <xs:documentation>Dieses Element bezeichnet das Format des binärcodierten Dokuments.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="referenzAufSachverhalt.id"
                              minOccurs="0"
                              type="xauslaender:ReferenzId">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird die Referenz-ID des Sachverhalts übermittelt, dem das Dokument zugeordnet werden soll.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="dokumentId" minOccurs="0" type="din91379:datatypeC">
                     <xs:annotation>
                        <xs:documentation>Dieses Element enthält die ID des Dokumentes. Diese ist nur bei Änderungsart Löschung anzugeben.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:any minOccurs="0"
                          maxOccurs="unbounded"
                          namespace="http://www.osci.de/xauslaender2611/azr-erweiterung"
                          processContents="lax"/>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="VonBAMF.AZRRegisterabgleichsveranlassung.090020">
      <xs:annotation>
         <xs:appinfo>
            <title>Veranlassungsnachricht zum Registerabgleich mit dem AZR</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht übermittelt das bamf eine Veranlassung zum AZR-Registerabgleich an die abh.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Nachricht.G2G.XA">
               <xs:sequence>
                  <xs:element name="zweck" type="xauslaender:Code.AZR.Registerabgleichzweck">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird der Zweck des Registerabgleichs mitgeteilt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="hinweis" minOccurs="0" type="din91379:datatypeC">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element kann ein Hinweis übermittelt werden, warum das bamf Zweifel an der Richtigkeit und Aktualität des Datenbestandes hat.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="AnAZR.AZRRegisterabgleichsanfrage.090021">
      <xs:annotation>
         <xs:appinfo>
            <title>Anfragenachricht für Registerabgleichsdaten an das AZR</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht übermittelt die abh eine Anfrage zu Registerabgleichsdaten an das AZR.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Nachricht.G2G.XA.AnAZR">
               <xs:sequence>
                  <xs:element name="von" minOccurs="0" type="xida:Tagesdatum">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird das Datum angegeben ab dem Datensätze im AZR angelegt wurden.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="bis" minOccurs="0" type="xida:Tagesdatum">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird das Datum angegeben bis zu dem Datensätze im AZR angelegt wurden.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="zweck" type="xauslaender:Code.AZR.Registerabgleichzweck">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird der Zweck des Registerabgleichs mitgeteilt. Sofern der Abgleich durch das Bundesamt für Migration und Flüchtlinge mit der nachricht.ref.090020 angestoßen wurde, ist der identische Zweck des Registerabgleichs zu übernehmen.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="VonAZR.AZRRegisterabgleichsdaten.090022">
      <xs:annotation>
         <xs:appinfo>
            <title>Registerabgleichsdaten vom AZR</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht übermittelt das AZR die AZR-Nummern und ggf. die Referenz-ID der Entitäten der für den Datenabgleich relevanten Datensätze an die Ausländerbehörde.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Nachricht.G2G.XA.VonAZR">
               <xs:sequence>
                  <xs:element name="azrNummern">
                     <xs:annotation>
                        <xs:documentation>In diesem Container werden alle AZR-Nummern übermittelt, die für den angefragten Zeitraum gefunden wurden. Im Fall des erweiterten Registerabgleichs, werden die definierten Referenz-ID der Entitäten zu der jeweiligen AZR-Nummer ebenfalls übermittelt.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:sequence>
                           <xs:element name="abgleichergebnis" minOccurs="0" maxOccurs="unbounded">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element werden die AZR-Nummern zu den Datensätzen übermittelt, für die ein aktueller Meldestatus Code 01, 02, 03 oder 09 gilt (Aufenthalt im Bundesgebiet) und das AZR die anfragende ABH als zuständig erachtet und ggf. die Referenz-ID der Entitäten.</xs:documentation>
                              </xs:annotation>
                              <xs:complexType>
                                 <xs:sequence>
                                    <xs:element name="azrNummer" type="xiaz:AZRNummer">
                                       <xs:annotation>
                                          <xs:documentation>Mit diesem Element wird die AZR-Nummer des betreffenden Datensatzes übermittelt.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                    <xs:element name="abgleichMitReferenzID" minOccurs="0">
                                       <xs:annotation>
                                          <xs:documentation>Im Falle eines erweiterten Datenabgleichs mit Referenz-ID der Entitäten, werden mit diesem Element die Referenz-ID der Entitäten übermittelt. Im Falle eines rein quantitativen Abgleichs werden hier keine Daten übermittelt.</xs:documentation>
                                       </xs:annotation>
                                       <xs:complexType>
                                          <xs:sequence>
                                             <xs:element name="abschiebung"
                                                         minOccurs="0"
                                                         maxOccurs="unbounded"
                                                         type="xauslaender:ReferenzId">
                                                <xs:annotation>
                                                   <xs:documentation>Mit diesem Element wird die Referenz-ID der Abschiebung (siehe ) zu einer bestimmten AZR-Nummer übermittelt.</xs:documentation>
                                                </xs:annotation>
                                             </xs:element>
                                             <xs:element name="anschrift" minOccurs="0" type="xauslaender:ReferenzId">
                                                <xs:annotation>
                                                   <xs:documentation>Mit diesem Element wird die Referenz-ID der gegenwärtigen Anschrift (siehe ) zu einer bestimmten AZR-Nummer übermittelt.</xs:documentation>
                                                </xs:annotation>
                                             </xs:element>
                                             <xs:element name="geasAsylstatus" minOccurs="0" type="xauslaender:ReferenzId">
                                                <xs:annotation>
                                                   <xs:documentation>Mit diesem Element wird die Referenz-ID des aktuellen GEAS-Asylstatus (siehe ) zu einer bestimmten AZR-Nummer übermittelt.</xs:documentation>
                                                </xs:annotation>
                                             </xs:element>
                                             <xs:element name="asylstatus" minOccurs="0" type="xauslaender:ReferenzId">
                                                <xs:annotation>
                                                   <xs:documentation>Mit diesem Element wird die Referenz-ID des aktuellen Asylstatus (siehe ) zu einer bestimmten AZR-Nummer übermittelt.</xs:documentation>
                                                </xs:annotation>
                                             </xs:element>
                                             <xs:element name="aufenthaltserlaubnis"
                                                         minOccurs="0"
                                                         maxOccurs="unbounded"
                                                         type="xauslaender:ReferenzId">
                                                <xs:annotation>
                                                   <xs:documentation>Mit diesem Element wird die Referenz-ID der Aufenthaltserlaubnis (siehe ) zu einer bestimmten AZR-Nummer übermittelt.</xs:documentation>
                                                </xs:annotation>
                                             </xs:element>
                                             <xs:element name="aufenthaltsgestattung"
                                                         minOccurs="0"
                                                         maxOccurs="unbounded"
                                                         type="xauslaender:ReferenzId">
                                                <xs:annotation>
                                                   <xs:documentation>Mit diesem Element wird die Referenz-ID einer Aufenthaltsgestattung (siehe ) zu einer bestimmten AZR-Nummer übermittelt.</xs:documentation>
                                                </xs:annotation>
                                             </xs:element>
                                             <xs:element name="aufenthaltsrechtEU"
                                                         minOccurs="0"
                                                         maxOccurs="unbounded"
                                                         type="xauslaender:ReferenzId">
                                                <xs:annotation>
                                                   <xs:documentation>Mit diesem Element wird die Referenz-ID eines EU-Aufenthaltsrechts (siehe ) zu einer bestimmten AZR-Nummer übermittelt.</xs:documentation>
                                                </xs:annotation>
                                             </xs:element>
                                             <xs:element name="aufenthaltsstatus"
                                                         minOccurs="0"
                                                         maxOccurs="unbounded"
                                                         type="xauslaender:ReferenzId">
                                                <xs:annotation>
                                                   <xs:documentation>Mit diesem Element wird die Referenz-ID des Aufenthaltsstatus (siehe ) zu einer bestimmten AZR-Nummer übermittelt.</xs:documentation>
                                                </xs:annotation>
                                             </xs:element>
                                             <xs:element name="ausweispapier" minOccurs="0" type="xauslaender:ReferenzId">
                                                <xs:annotation>
                                                   <xs:documentation>Mit diesem Element wird die Referenz-ID des aktuell gespeicherten Ausweispapiers (siehe ) zu einer bestimmten AZR-Nummer übermittelt.</xs:documentation>
                                                </xs:annotation>
                                             </xs:element>
                                             <xs:element name="ausweisung"
                                                         minOccurs="0"
                                                         maxOccurs="unbounded"
                                                         type="xauslaender:ReferenzId">
                                                <xs:annotation>
                                                   <xs:documentation>Mit diesem Element wird die Referenz-ID der Ausweisung (siehe ) zu einer bestimmten AZR-Nummer übermittelt.</xs:documentation>
                                                </xs:annotation>
                                             </xs:element>
                                             <xs:element name="duldung"
                                                         minOccurs="0"
                                                         maxOccurs="unbounded"
                                                         type="xauslaender:ReferenzId">
                                                <xs:annotation>
                                                   <xs:documentation>Mit diesem Element wird die Referenz-ID einer Duldung (siehe ) zu einer bestimmten AZR-Nummer übermittelt.</xs:documentation>
                                                </xs:annotation>
                                             </xs:element>
                                             <xs:element name="einreiseAufenthaltsverbot"
                                                         minOccurs="0"
                                                         maxOccurs="unbounded"
                                                         type="xauslaender:ReferenzId">
                                                <xs:annotation>
                                                   <xs:documentation>Mit diesem Element wird die Referenz-ID eines Einreise- und Aufenthaltsverbots (siehe ) zu einer bestimmten AZR-Nummer übermittelt.</xs:documentation>
                                                </xs:annotation>
                                             </xs:element>
                                             <xs:element name="grundpersonalien" type="xauslaender:ReferenzId">
                                                <xs:annotation>
                                                   <xs:documentation>Mit diesem Element wird die Referenz-ID der Grundpersonalien (siehe ) zu einer bestimmten AZR-Nummer übermittelt.</xs:documentation>
                                                </xs:annotation>
                                             </xs:element>
                                             <xs:element name="meldestatus"
                                                         minOccurs="0"
                                                         maxOccurs="2"
                                                         type="xauslaender:ReferenzId">
                                                <xs:annotation>
                                                   <xs:documentation>Mit diesem Element wird die Referenz-ID des zuerst gespeicherten oder des aktuellen Meldestatus (siehe ) zu einer bestimmten AZR-Nummer übermittelt.</xs:documentation>
                                                </xs:annotation>
                                             </xs:element>
                                             <xs:element name="niederlassungserlaubnis"
                                                         minOccurs="0"
                                                         maxOccurs="unbounded"
                                                         type="xauslaender:ReferenzId">
                                                <xs:annotation>
                                                   <xs:documentation>Mit diesem Element wird die Referenz-ID einer Niederlassungserlaubnis (siehe ) zu einer bestimmten AZR-Nummer übermittelt.</xs:documentation>
                                                </xs:annotation>
                                             </xs:element>
                                             <xs:element name="wohnsitzauflageRaeumlicheBeschraenkung"
