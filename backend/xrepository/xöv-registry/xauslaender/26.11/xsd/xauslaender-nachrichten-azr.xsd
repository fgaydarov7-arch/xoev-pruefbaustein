                           <xs:element name="trefferPassdatensuche"
                                       maxOccurs="unbounded"
                                       type="xauslaender:AZR.TrefferPassdatensuche.Auskunft"/>
                        </xs:choice>
                     </xs:complexType>
                  </xs:element>
                  <xs:element name="behoerdendaten"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xauslaender:AZR.Behoerde"/>
                  <xs:any minOccurs="0"
                          maxOccurs="unbounded"
                          namespace="http://www.osci.de/xauslaender2611/azr-erweiterung"
                          processContents="lax"/>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
