   <xs:complexType name="AZR.SisAusschreibungshintergrund.Auskunft">
      <xs:annotation>
         <xs:appinfo>
            <title>SIS-Ausschreibungshintergrund</title>
         </xs:appinfo>
         <xs:documentation>Der SIS-Ausschreibungshintergrund zeigt an, dass für diesen Ausländer eine Ausschreibung im Schengener Informationssystem (SIS) existiert. Er ist stets einem anderen Sachverhalt, der sogenannten Grundlage (s. Element referenzAufSachverhalt.id), zugeordnet. Es sind nur solche SIS-Ausschreibungen im AZR zu erfassen, die aufgrund einer aufenthaltsrechtlichen Entscheidung an das SIS gemeldet wurden und einen unmittelbar zusammenhängenden AZR-Sachverhalt haben (Rückkehrentscheidung, EinreiseAufenthaltsVerweigerung).</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="sisId" type="din91379:datatypeC">
            <xs:annotation>
               <xs:documentation>Die Schengen-Identifikationsnummer identifiziert eine Ausschreibung im Schengener Informationssystem (SIS) eindeutig. Sie dient im AZR als eindeutiger Zugriffsschlüssel.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="straftat" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
               <xs:documentation>Dieses Element enthält die der SIS-Ausschreibung zugrundeliegenden Straftaten.</xs:documentation>
            </xs:annotation>
            <xs:complexType>
               <xs:sequence>
                  <xs:element name="straftatBezeichnung" type="din91379:datatypeC">
                     <xs:annotation>
                        <xs:documentation>Die Bezeichnung der Straftat nach den deutschen Strafvorschriften, welche der Ausschreibung zugrunde liegt (z. B. „Totschlag“).</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="strafvorschrift" type="din91379:datatypeC">
                     <xs:annotation>
                        <xs:documentation>Die Strafvorschrift aus den deutschen Rechtsgrundlagen, nach der die Strafe verhängt wurde (z. B. „§ 212 StGB“).</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="strafart" type="xauslaender:Code.AZR.Strafart">
                     <xs:annotation>
                        <xs:documentation>Dieses Element übermittelt die Art der Strafe</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="strafmass" minOccurs="0">
                     <xs:annotation>
                        <xs:documentation>Dieses Element übermittelt das Strafmaß. Bei Freiheits-, Jugend- oder Geldstrafen ist die Angabe verpflichtend.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:choice>
                           <xs:element name="freiheitsstrafe">
                              <xs:complexType>
                                 <xs:sequence>
                                    <xs:element name="strafmassJahre" minOccurs="0" type="xs:nonNegativeInteger">
                                       <xs:annotation>
                                          <xs:documentation>Die Dauer einer verhängten Freiheitsstrafe in Jahren.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                    <xs:element name="strafmassMonate" minOccurs="0" type="xs:nonNegativeInteger">
                                       <xs:annotation>
                                          <xs:documentation>Die Dauer einer verhängten Freiheitsstrafe in Monaten.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                    <xs:element name="strafmassWochen" minOccurs="0" type="xs:nonNegativeInteger">
                                       <xs:annotation>
                                          <xs:documentation>Die Dauer einer verhängten Freiheitsstrafe in Wochen.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                    <xs:element name="strafmassTage" minOccurs="0" type="xs:nonNegativeInteger">
                                       <xs:annotation>
                                          <xs:documentation>Die Dauer einer verhängten Freiheitsstrafe in Tagen.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                 </xs:sequence>
                              </xs:complexType>
                           </xs:element>
                           <xs:element name="geldstrafe">
                              <xs:complexType>
                                 <xs:sequence>
                                    <xs:element name="strafmassTage" type="xs:nonNegativeInteger">
                                       <xs:annotation>
                                          <xs:documentation>Die Anzahl der Tagessätze bei einer Geldstrafe.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                    <xs:element name="strafmassTagessatz" type="xs:nonNegativeInteger">
                                       <xs:annotation>
                                          <xs:documentation>Die Höhe eines verhängten Tagessatzes.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                 </xs:sequence>
                              </xs:complexType>
                           </xs:element>
                        </xs:choice>
                     </xs:complexType>
                  </xs:element>
               </xs:sequence>
            </xs:complexType>
         </xs:element>
         <xs:element name="referenzAufSachverhalt.id" type="xauslaender:ReferenzId">
            <xs:annotation>
               <xs:documentation>Dieses Element enthält die Referenz-ID des Sachverhalts, auf die sich der SIS-Ausschreibungshintergrund bezieht. Referenzierte Sachverhalte könnten folgende sein: Abschiebung, Abschiebungsverbot, Asylstatus, Aufenthaltsstatus, Ausweisung, EinreiseUndAufenthaltsverbot, ZurückweisungZurückschiebung</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="meldendeBehoerde"
                     minOccurs="0"
                     type="xauslaender:AZR.Behoerdenkennzeichen">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird die Behördenkennung der Behörde übermittelt, die den Sachverhalt gemeldet hat.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="letzteAenderung" minOccurs="0" type="xida:Tagesdatum">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird das Datum des letzten schreibenden Zugriffs übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="referenz.id" type="xauslaender:ReferenzId">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird die Referenz-ID zur Identifizierung des betreffenden Sachverhalts innerhalb des Datensatzes übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:any minOccurs="0"
                 maxOccurs="unbounded"
                 namespace="http://www.osci.de/xauslaender2611/azr-erweiterung"
                 processContents="lax"/>
      </xs:sequence>
   </xs:complexType>
