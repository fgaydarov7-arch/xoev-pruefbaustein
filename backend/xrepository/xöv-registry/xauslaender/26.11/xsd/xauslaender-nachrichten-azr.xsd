      <xs:sequence>
         <xs:element name="abschiebungArt" type="xauslaender:Code.AZR.AbschiebungArt">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird die Information zur Abschiebung oder Freiheitsentziehung mitgeteilt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="ereignisdatum" minOccurs="0" type="xida:Tagesdatum">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird das Datum der Abschiebung bzw. des Haftantritts übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="rechtskraftdatum" minOccurs="0" type="xida:Tagesdatum">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird das Datum übermittelt, an dem die Maßnahme vollziehbar wird.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="befristungsangabe"
                     minOccurs="0"
                     type="xauslaender:AZR.Befristungsangabe">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird das Befristungsdatum oder der Befristungszeitraum übermittelt, sofern die Abschiebung befristet verfügt wurde. Im Falle einer Freiheitsentziehung wird das Befristungsdatum dieser Maßnahme übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="referenzAufAusweisung.id"
                     minOccurs="0"
                     type="xauslaender:ReferenzId">
            <xs:annotation>
               <xs:documentation>Dieses Element enthält die Referenz-ID der Ausweisung, die der Abschiebung zugrunde liegt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="zustelldatum" minOccurs="0" type="xida:Tagesdatum">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird das Zustelldatum des Bescheids übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="loeschdatum" minOccurs="0" type="xida:Tagesdatum">
            <xs:annotation>
               <xs:documentation>Mit diesem Element wird das Löschdatum übermittelt.</xs:documentation>
            </xs:annotation>
