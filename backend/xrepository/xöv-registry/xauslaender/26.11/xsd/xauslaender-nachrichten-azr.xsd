   <xs:element name="AnBAMF.AZRRegisterabgleichsstatistik.090023">
      <xs:annotation>
         <xs:appinfo>
            <title>Abgleichsstatistik zum Registerabgleich mit dem AZR</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht übermittelt die abh die Statistik zum Registerabgleich an das bamf. In dem Element ausloeserUUID muss die UUID der nachricht.ref.090020 übermittelt werden, auf die diese Nachricht als Antwort geschickt wird.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Antwortnachricht.G2G.XA">
               <xs:sequence>
                  <xs:element name="uebereinstimmendeAZRNummer"
                              minOccurs="0"
                              maxOccurs="unbounded">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element werden übereinstimmende AZR-Nummern und ggf. Referenz-ID übermittelt.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:sequence>
                           <xs:element name="azrNummer" type="xiaz:AZRNummer">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element wird die AZR-Nummer übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="abgleichMitReferenzID" minOccurs="0">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element werden die Ergebnisse des Abgleichs der Referenz-ID übermittelt.</xs:documentation>
                              </xs:annotation>
                              <xs:complexType>
                                 <xs:sequence>
                                    <xs:element name="abschiebung"
                                                maxOccurs="unbounded"
                                                type="xauslaender:AZR.Abgleichergebnis"/>
                                    <xs:element name="anschrift" type="xauslaender:AZR.Abgleichergebnis"/>
                                    <xs:element name="geasAsylstatus" type="xauslaender:AZR.Abgleichergebnis"/>
                                    <xs:element name="asylstatus" type="xauslaender:AZR.Abgleichergebnis"/>
                                    <xs:element name="aufenthaltserlaubnis"
                                                maxOccurs="unbounded"
                                                type="xauslaender:AZR.Abgleichergebnis"/>
                                    <xs:element name="aufenthaltsgestattung"
                                                maxOccurs="unbounded"
                                                type="xauslaender:AZR.Abgleichergebnis"/>
                                    <xs:element name="aufenthaltsrechtEU"
                                                maxOccurs="unbounded"
                                                type="xauslaender:AZR.Abgleichergebnis"/>
                                    <xs:element name="aufenthaltsstatus"
                                                maxOccurs="unbounded"
                                                type="xauslaender:AZR.Abgleichergebnis"/>
                                    <xs:element name="ausweispapier" type="xauslaender:AZR.Abgleichergebnis"/>
                                    <xs:element name="ausweisung"
                                                maxOccurs="unbounded"
                                                type="xauslaender:AZR.Abgleichergebnis"/>
                                    <xs:element name="duldung"
                                                maxOccurs="unbounded"
                                                type="xauslaender:AZR.Abgleichergebnis"/>
                                    <xs:element name="einreiseAufenthaltsverbot"
                                                maxOccurs="unbounded"
                                                type="xauslaender:AZR.Abgleichergebnis"/>
                                    <xs:element name="grundpersonalien" type="xauslaender:AZR.Abgleichergebnis"/>
                                    <xs:element name="meldestatus"
                                                maxOccurs="2"
                                                type="xauslaender:AZR.Abgleichergebnis"/>
                                    <xs:element name="niederlassungserlaubnis"
                                                maxOccurs="unbounded"
                                                type="xauslaender:AZR.Abgleichergebnis"/>
                                    <xs:element name="wohnsitzauflageRaeumlicheBeschraenkung"
                                                maxOccurs="unbounded"
                                                type="xauslaender:AZR.Abgleichergebnis"/>
                                 </xs:sequence>
                              </xs:complexType>
                           </xs:element>
                        </xs:sequence>
                     </xs:complexType>
                  </xs:element>
                  <xs:element name="azrNummerNichtInA-Datei"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xiaz:AZRNummer">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element werden die AZR-Nummern übermittelt, die nicht in der Ausländerdatei A gespeichert sind.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="azrNummerNichtInAbgleichsdaten"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xiaz:AZRNummer">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element werden die AZR-Nummern übermittelt, die in der Ausländerdatei A gespeichert sind, aber nicht in der Liste der AZR-Nummern der nachricht.ref.090022 vorlagen.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="paketierung">
                     <xs:annotation>
                        <xs:documentation>Dieses Element sichert die korrekte Abfolge aller Pakete (paketnummer) einer Lieferung (UUID der auslösenden nachricht.ref.090020) und dient gleichzeitig der Vollständigkeitskontrolle (Kennzeichen letztes.paket). Ein Paket darf maximal 50.000 Datensätze (korrespondierend zu AZR-Nummern) enthalten. Nachfolgend ist beispielhaft die Markierung der korrekten Reihenfolge von Paketen innerhalb einer Lieferung dargestellt. paketnummer letztes.paket 1 false 2 false 3 true</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:sequence>
                           <xs:element name="paketnummer" type="xs:positiveInteger">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element wird jedem Paket einer Lieferung eine fortlaufende Nummer vergeben, um eine eindeutige Identifizierung innerhalb der Lieferung zu ermöglichen.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="letztes.paket" type="xs:boolean">
                              <xs:annotation>
                                 <xs:documentation>Dieser Wert bezeichnet, ob es sich um das letzte Paket einer Lieferung handelt oder nicht.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                        </xs:sequence>
                     </xs:complexType>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="VonAZR.AZRMitteilungZuDatenaenderung.090030">
      <xs:annotation>
         <xs:appinfo>
            <autor>Ausländerzentralregister (dbs:490030020000)</autor>
            <leser>Ausländerbehörde (azr), Bundesbehörde (dbs), Optionskommune (opt)</leser>
            <rechtsgrundlage>§ 6, 8, 10-14 AZRG</rechtsgrundlage>
            <title>AZR-Mitteilung zu Datenänderung</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht wird aufgrund gesetzlicher Regelungen eine Datenänderung durch das AZR mitgeteilt.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Nachricht.G2G.XA.VonAZR">
               <xs:sequence>
                  <xs:element name="azrNummer" type="xiaz:AZRNummer"/>
                  <xs:element name="mitteilungsAusloeser"
                              minOccurs="0"
                              type="xauslaender:Code.AZR.MitteilungsAusloeserArt"/>
                  <xs:element name="ausloesendeBehoerde"
                              minOccurs="0"
                              type="xauslaender:AZR.Behoerdenkennzeichen">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird die Behörde übermittelt, die den Nachbericht ausgelöst hat. Dieses Element ist nur zu befüllen, wenn es sich um eine Mitteilung nach § 38 AZRG handelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="ausloesungsdatum" minOccurs="0" type="xida:Tagesdatum">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird das Datum übermittelt, zu dem der Nachbericht ausgelöst wurde. Dieses Element ist nur zu befüllen, wenn es sich um eine Mitteilung nach § 38 AZRG handelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="handlungsempfehlung" minOccurs="0" type="din91379:datatypeC">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element werden Handlungsempfehlungen in Bezug auf den Umgang mit der Mitteilung übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="inhaltAktuell"
                              minOccurs="0"
                              type="xauslaender:AZR.Datensatzinhalt">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element werden die aktuellen betreffenden Inhalte des Datensatzes übermittelt. Dabei kann es sich auch um die betreffenden Inhalte nach mitteilungsrelevanter Datenänderung des Datensatzes handeln.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="inhaltVorAenderung"
                              minOccurs="0"
                              type="xauslaender:AZR.Datensatzinhalt">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element werden die betreffenden Inhalte vor mitteilungsrelevanter Datenänderung des Datensatzes übermittelt. Im Falle einer Dublettenzusammenführung werden die Inhalte des gelöschten Datensatzes übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="wegfallendeAzrNummer" minOccurs="0" type="xiaz:AZRNummer">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird im Falle einer Dublettenzusammenführung die wegfallende AZR-Nummer übermittelt. Die Inhalte dieses Datensatzes werden im Element inhaltVorAenderung übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="behoerdendaten"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xauslaender:AZR.Behoerde"/>
                  <xs:any minOccurs="0"
                          maxOccurs="unbounded"
                          namespace="http://www.osci.de/xauslaender2611/azr-erweiterung"
                          processContents="lax"/>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="AnAZR.AZRDatenpflegeAnfrage.090040">
      <xs:annotation>
         <xs:appinfo>
            <autor>Kommunikationspartner des AZR nach § 22 AZRG (kein Präfix festgelegt)</autor>
            <leser>Ausländerzentralregister (kein Präfix festgelegt)</leser>
            <rechtsgrundlage>§ 10 AZRG</rechtsgrundlage>
            <title>AZR-Datenpflegeanfrage</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht wird eine Datenpflegeanfrage an den Allgemeinen Datenbestand des AZR gerichtet.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Nachricht.G2G.XA.AnAZR">
               <xs:sequence>
                  <xs:element name="datenpflegeanlass">
                     <xs:complexType>
                        <xs:choice>
                           <xs:element name="mehrfacherfassung">
                              <xs:annotation>
                                 <xs:documentation>Dieses Element enthält die AZR-Nummern, die aus Sicht der meldenden Behörde Mehrfacherfassungen einer Person sind.</xs:documentation>
                              </xs:annotation>
                              <xs:complexType>
                                 <xs:sequence>
                                    <xs:element name="azrNummer"
                                                minOccurs="2"
                                                maxOccurs="unbounded"
                                                type="xiaz:AZRNummer">
                                       <xs:annotation>
                                          <xs:documentation>Mit diesem Element wird die AZR-Nummer übermittelt.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                 </xs:sequence>
                              </xs:complexType>
                           </xs:element>
                           <xs:any minOccurs="0"
                                   maxOccurs="unbounded"
                                   namespace="http://www.osci.de/xauslaender2611/azr-erweiterung"
                                   processContents="lax"/>
                        </xs:choice>
                     </xs:complexType>
                  </xs:element>
                  <xs:any minOccurs="0"
                          maxOccurs="unbounded"
                          namespace="http://www.osci.de/xauslaender2611/azr-erweiterung"
                          processContents="lax"/>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="AnAZR.AZRVerpflichtungsgeberAnfrage.090051">
      <xs:annotation>
         <xs:appinfo>
            <autor>Kommunikationspartner des AZR nach § 22 AZRG (kein Präfix festgelegt)</autor>
            <leser>Ausländerzentralregister (kein Präfix festgelegt)</leser>
            <rechtsgrundlage>§ 10 AZRG</rechtsgrundlage>
            <title>Anfragenachricht für Auskunftsersuchen zum Verpflichtungsgeber an das AZR - Allgemeiner Datenbestand und Visadatei</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht wird eine Anfrage zum Verpflichtungsgeber an die Visadatei und den Allgemeinen Datenbestand des AZR gerichtet.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Nachricht.G2G.XA.AnAZR">
               <xs:sequence>
                  <xs:element name="abrufzweck" type="xauslaender:Code.AZR.Abrufzweck">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird der Abrufzweck mitgeteilt. Die Angabe wird für die Protokollierung der Anfrage verwendet.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="geschaeftszeichen" minOccurs="0" type="din91379:datatypeC">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird das Geschäftszeichen des Verfahrens oder das lokale Aktenzeichen der anfragenden Behörde übermittelt. Die Angabe wird für die Protokollierung der Anfrage verwendet.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="anfrageVerpflichtungsgeber">
                     <xs:annotation>
                        <xs:documentation>Für die Anfrage zum Verpflichtungsgeber für natürliche Personen kann ein Katalog von Personalien oder für juristische Personen Angaben zur juristischen Person verwendet werden.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:choice>
                           <xs:element name="natuerlichePerson">
                              <xs:complexType>
                                 <xs:sequence>
                                    <xs:element name="familienname" type="xian:AllgemeinerName"/>
                                    <xs:element name="vorname" type="xian:AllgemeinerName"/>
                                    <xs:element name="tagDerGeburt" type="xida:TeilbekanntesDatumMitUnbekannt"/>
                                    <xs:element name="geburtsort" type="xauslaender:Geburtsort"/>
                                    <xs:any minOccurs="0"
                                            maxOccurs="unbounded"
                                            namespace="http://www.osci.de/xauslaender2611/azr-erweiterung"
                                            processContents="lax"/>
                                 </xs:sequence>
                              </xs:complexType>
                           </xs:element>
                           <xs:element name="juristischePerson">
                              <xs:complexType>
                                 <xs:sequence>
                                    <xs:element name="name" type="din91379:datatypeC"/>
                                    <xs:any minOccurs="0"
                                            maxOccurs="unbounded"
                                            namespace="http://www.osci.de/xauslaender2611/azr-erweiterung"
                                            processContents="lax"/>
                                 </xs:sequence>
                              </xs:complexType>
                           </xs:element>
                        </xs:choice>
                     </xs:complexType>
                  </xs:element>
                  <xs:any minOccurs="0"
                          maxOccurs="unbounded"
                          namespace="http://www.osci.de/xauslaender2611/azr-erweiterung"
                          processContents="lax"/>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="VonAZR.AZRVerpflichtungsgeberTrefferliste.090053">
      <xs:annotation>
         <xs:appinfo>
            <autor>Kommunikationspartner des AZR nach § 22 AZRG (kein Präfix festgelegt)</autor>
            <leser>Ausländerzentralregister (kein Präfix festgelegt)</leser>
            <rechtsgrundlage>§ 10 AZRG</rechtsgrundlage>
            <title>AZR-Trefferliste zum Verpflichtungsgeber</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht wird das Ergebnis einer Anfrage zum Verpflichtungsgeber an die Visadatei und an den Allgemeinen Datenbestand des AZR in Form einer Liste übermittelt. Je nach gewählter Anfrage bekommt man eine Liste von natürlichen oder juristischen Personen zurück. Diese Personen können mehrfach in der Liste enthalten sein, da das entscheidende Kriterium zur Differenzierung die abgegebene Verpflichtungserklärung ist.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Nachricht.G2G.XA.AnAZR">
               <xs:sequence>
                  <xs:element name="treffer" maxOccurs="unbounded">
                     <xs:complexType>
                        <xs:sequence>
                           <xs:element name="trefferbewertung" type="xauslaender:Code.AZR.TrefferKategorie">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element wird die Trefferbewertung des AZR übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="verpflichtungsgeber">
                              <xs:annotation>
                                 <xs:documentation>Für die Anfrage zum Verpflichtungsgeber für natürliche Personen kann ein Katalog von Personalien oder für juristische Personen Angaben zur juristischen Person verwendet werden.</xs:documentation>
                              </xs:annotation>
                              <xs:complexType>
                                 <xs:choice>
                                    <xs:element name="natuerlichePerson">
                                       <xs:complexType>
                                          <xs:sequence>
                                             <xs:element name="familienname" minOccurs="0" type="xian:AllgemeinerName"/>
                                             <xs:element name="vorname" minOccurs="0" type="xian:AllgemeinerName"/>
                                             <xs:element name="tagDerGeburt"
                                                         minOccurs="0"
                                                         type="xida:TeilbekanntesDatumMitUnbekannt"/>
                                             <xs:element name="geburtsort" minOccurs="0" type="xauslaender:Geburtsort"/>
                                             <xs:element name="anschrift" minOccurs="0">
                                                <xs:complexType>
                                                   <xs:choice>
                                                      <xs:element name="inland" type="xima:Meldeanschrift"/>
                                                      <xs:element name="ausland" type="xauslaender:AZR.Auslandsanschrift"/>
                                                   </xs:choice>
                                                </xs:complexType>
                                             </xs:element>
                                             <xs:any minOccurs="0"
                                                     maxOccurs="unbounded"
                                                     namespace="http://www.osci.de/xauslaender2611/azr-erweiterung"
                                                     processContents="lax"/>
                                          </xs:sequence>
                                       </xs:complexType>
                                    </xs:element>
                                    <xs:element name="juristischePerson">
                                       <xs:complexType>
                                          <xs:sequence>
                                             <xs:element name="name" minOccurs="0" type="din91379:datatypeC">
                                                <xs:annotation>
                                                   <xs:documentation>Mit diesem Element wird der Name des Unternehmens, eines Vereins oder einer sonstigen Organisation, in deren Namen die Verpflichtungserklärung abgegeben wird, übermittelt.</xs:documentation>
                                                </xs:annotation>
                                             </xs:element>
                                             <xs:element name="anschrift" minOccurs="0">
                                                <xs:complexType>
                                                   <xs:choice>
                                                      <xs:element name="inland" type="xipa:PostalischeInlandsanschrift.Gebaeudeanschrift"/>
                                                      <xs:element name="ausland" type="xauslaender:AZR.Auslandsanschrift"/>
                                                   </xs:choice>
                                                </xs:complexType>
                                             </xs:element>
                                             <xs:any minOccurs="0"
                                                     maxOccurs="unbounded"
                                                     namespace="http://www.osci.de/xauslaender2611/azr-erweiterung"
                                                     processContents="lax"/>
                                          </xs:sequence>
                                       </xs:complexType>
                                    </xs:element>
                                 </xs:choice>
                              </xs:complexType>
                           </xs:element>
                           <xs:element name="erfolgloseInanspruchnahmeAm"
                                       minOccurs="0"
                                       type="xida:Tagesdatum">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element wird das Datum der Feststellung einer erfolglosen Inanspruchnahme der Verpflichtungserklärung übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="verpflichtungserklaerungArt"
                                       minOccurs="0"
                                       type="xauslaender:Code.AZR.VerpflichtungserklaerungArt">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element wird die Art der Verpflichtungserklärung übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="ereignisdatum" minOccurs="0" type="xida:Tagesdatum">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element wird das Datum der Ausstellung der Verpflichtungserklärung übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="vorhaltendeBehoerde"
                                       minOccurs="0"
                                       type="xauslaender:AZR.Behoerdenkennzeichen">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element wird die Behördenkennung der Stelle übermittelt, bei der die Verpflichtungserklärung hinterlegt wurde.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="quelle">
                              <xs:annotation>
                                 <xs:documentation>Anhand der Kindelemente lässt sich erkennen aus welcher Quelle (AZR oder Visadatei) der Treffer kommt.</xs:documentation>
                              </xs:annotation>
                              <xs:complexType>
                                 <xs:choice>
                                    <xs:element name="azr" type="xiaz:AZRNummer">
                                       <xs:annotation>
                                          <xs:documentation>Mit diesem Element wird der AZR-Datensatz identifiziert, zu dem die Verpflichtungserklärung mit dem gefundenen Verpflichtungsgeber gespeichert ist.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                    <xs:element name="visadatei" type="din91379:datatypeC">
                                       <xs:annotation>
                                          <xs:documentation>Mit diesem Element wird der Datensatz des Visumantrags identifiziert, zu dem die Verpflichtungserklärung mit dem gefundenen Verpflichtungsgeber gespeichert ist.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                 </xs:choice>
                              </xs:complexType>
                           </xs:element>
                           <xs:element name="dokumentId" minOccurs="0" type="din91379:datatypeC">
                              <xs:annotation>
                                 <xs:documentation>Dieses Element enthält die ID des Dokuments zum Abruf in der Visadatei oder dem Allgemeinen Datenbestand des AZR in Abhängigkeit der Quelle des Treffers.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="loeschdatum" minOccurs="0" type="xida:Tagesdatum">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element wird das Löschdatum übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="meldendeBehoerde"
                                       minOccurs="0"
                                       type="xauslaender:AZR.Behoerdenkennzeichen">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element wird die Behördenkennung der Behörde übermittelt, die den Sachverhalt gemeldet hat.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="aktenzeichenMeldendeBehoerde"
                                       minOccurs="0"
                                       type="din91379:datatypeC">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element wird das Aktenzeichen der meldenden Behörde übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="letzteAenderung" minOccurs="0" type="xida:Tagesdatum">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element wird das Datum des letzten schreibenden Zugriffs übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:any minOccurs="0"
                                   maxOccurs="unbounded"
                                   namespace="http://www.osci.de/xauslaender2611/azr-erweiterung"
                                   processContents="lax"/>
                        </xs:sequence>
                     </xs:complexType>
                  </xs:element>
                  <xs:element name="behoerdendaten"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xauslaender:AZR.Behoerde"/>
                  <xs:any minOccurs="0"
                          maxOccurs="unbounded"
                          namespace="http://www.osci.de/xauslaender2611/azr-erweiterung"
                          processContents="lax"/>
               </xs:sequence>
            </xs:extension>
