      <xs:annotation>
         <xs:appinfo>
            <autor>Ausländerzentralregister (kein Präfix festgelegt)</autor>
            <leser>Kommunikationspartner des AZR nach § 22 AZRG (kein Präfix festgelegt)</leser>
