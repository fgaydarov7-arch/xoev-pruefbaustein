                     type="xauslaender:Code.AZR.Verfuegungstextstatus">
            <xs:annotation>
               <xs:documentation>Dieses Element übermittelt den Hinweis ob und in welcher Form ein Begründungstext vorliegt oder ob keiner vorgesehen ist.</xs:documentation>
            </xs:annotation>
