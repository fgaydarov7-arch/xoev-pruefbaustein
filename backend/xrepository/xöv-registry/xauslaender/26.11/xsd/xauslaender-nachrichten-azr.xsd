                  <xs:element name="azrNummer" minOccurs="0" type="xiaz:AZRNummer">
                     <xs:annotation>
                        <xs:documentation>Die Angabe der AZR-Nummer ist für eine erfolgreiche Verarbeitung der Folgemeldung erforderlich. Die derzeitige Optionalität ist nur temporär und dient ausschließlich der Handhabung eines mit dem Bundesverwaltungsamt/AZR abgestimmten konkreten Anwendungsfalles.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="grundpersonalien"
                              minOccurs="0"
                              type="xauslaender:AZR.Grundpersonalien.Meldung"/>
                  <xs:element name="lichtbildAllgemein"
                              minOccurs="0"
                              type="xauslaender:AZR.LichtbildAllgemein.Meldung"/>
                  <xs:element name="lichtbildZuSuchvermerk"
                              minOccurs="0"
                              type="xauslaender:AZR.LichtbildZuSuchvermerk.Meldung"/>
