               <xs:documentation>Mit diesem Element wird das Abfrageergebnis zu den Grundpersonalien einer Person übermittelt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="weiterePersonalien"
                     type="xauslaender:AZR.WeiterePersonalien.Auskunft">
            <xs:annotation>
               <xs:documentation>Mit diesem Element können umfassende Angaben zu weiteren Personalien einer Person übermittelt werden.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="trefferbewertung"
                     minOccurs="0"
                     type="xauslaender:Code.AZR.TrefferKategorie">
