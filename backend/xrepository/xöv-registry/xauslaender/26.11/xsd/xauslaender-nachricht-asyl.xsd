         <xs:complexContent>
            <xs:extension base="xauslaender:Nachricht.G2G.XA">
               <xs:sequence>
                  <xs:element name="person" type="xauslaender:Asyl.Person">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element werden Daten der Person übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="asylgesuchGeaeussert" type="xs:boolean">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird angegeben, ob ein Asylgesuch geäußert wurde (true) oder es sich um einen Aufgriff ohne Asylgesuch handelt (false).</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="eurodac-treffer"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="din91379:datatypeC">
                     <xs:annotation>
                        <xs:documentation>Sofern EURODAC-Treffer zur betroffenen Person ermittelt wurden, sind diese mit diesem Element zu übermitteln. Der EURODAC-Treffer wird durch eine, von der EURODAC VO standardisierte, Eurodac-Nummer dargestellt, die von einem Mitgliedsstaat vergeben wurde.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="unbegleiteterMinderjaehriger"
                              minOccurs="0"
                              fixed="true"
                              type="xs:boolean">
                     <xs:annotation>
                        <xs:documentation>Sofern dieses Element übermittelt wird (true), handelt es sich bei der betroffenen Person um einen unbegleiteten Minderjährigen.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="haftfall" minOccurs="0" fixed="true" type="xs:boolean">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird übermittelt (true), dass sich die betreffende Person in Sicherungshaft befindet.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="anlagen"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xs:base64Binary">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element werden Anlagen übermittelt, die verfahrensseitig vom BAMF vorgegeben sind (siehe Checkliste zum Sammelvordruck). Die Sammelvordrucke sind auf der Webseite des BAMF zu finden: Aufgriff ohne Asylgesuch, Aufgriff mit Asylgesuch und Aufgriff unbegleitete Minderjährige.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="Asyl.WiederzuzugAZR.111201">
      <xs:annotation>
         <xs:appinfo>
            <autor>Ausländerbehörde (azr)</autor>
            <leser>Bundesamt für Migration und Flüchtlinge (dbs)</leser>
            <rechtsgrundlage>§ 71 Abs. 2 S. 2 i.V.m. § 54 AsylG</rechtsgrundlage>
            <title>Gemeldeter Wiederzuzug im AZR</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht teilen die zuständige abh (ABH/ZAB) oder ae (AE) dem BAMF mit, dass nach einer Folgeantragstellung der Wiederzuzug der unter dem BAMF-Aktenzeichen geführten Personen im AZR gemeldet wurde.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Asyl.Basisnachricht">
               <xs:sequence>
                  <xs:element name="person"
                              maxOccurs="unbounded"
                              type="xauslaender:Asyl.PersonGrunddatenMitAZRNummer">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element werden Daten der Personen übermittelt, die unter einem BAMF-Aktenzeichen geführt werden.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="anschrift" minOccurs="0" type="xima:Meldeanschrift">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird die aktuelle Anschrift des Ausländers übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="Asyl.VollzugAusreise.111202">
      <xs:annotation>
         <xs:appinfo>
            <autor>Ausländerbehörde (azr)</autor>
            <leser>Bundesamt für Migration und Flüchtlinge (dbs)</leser>
            <rechtsgrundlage>arg.e. § 11 Abs. 2 AufenthG</rechtsgrundlage>
            <title>Vollzug der Abschiebungsandrohung/-anordnung</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht teilt die zuständige abh (ABH/ZAB) dem bamf mit, dass die Abschiebung/Ausreise vollzogen wurde.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Asyl.Basisnachricht">
               <xs:sequence>
                  <xs:element name="person"
                              maxOccurs="unbounded"
                              type="xauslaender:Asyl.PersonGrunddatenMitAZRNummer">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element werden Daten der Person übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="vollzugsdatum" type="xida:Tagesdatum">
                     <xs:annotation>
                        <xs:documentation>Das Element gibt das Datum der freiwilligen Ausreise oder der Abschiebung an.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="abgeschoben" type="xs:boolean">
                     <xs:annotation>
                        <xs:documentation>Das Element gibt an, ob der Ausländer abgeschoben wurde. Wurde der Ausländer nicht abgeschoben, ist er freiwillig ausgereist.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="zielstaat" minOccurs="0" type="xauslaender:AngabenZumStaat">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird der Staat übermittelt in den der Ausländer nach Abschluss des Verfahrens ausreist.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="anlageAusreisebestaetigung"
                              minOccurs="0"
                              type="xs:base64Binary">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird ein Dokument zur Bestätigung der Ausreise übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="artDerAusreise">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird mitgeteilt, ob die Ausreise nachgewiesen ist oder freiwillig erfolgte.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:choice>
                           <xs:element name="nachgewieseneAusreise" fixed="true" type="xs:boolean">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element wird mitgeteilt, dass die Ausreise nachgewiesen ist.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="vermuteteFreiwilligeAusreise" fixed="true" type="xs:boolean">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element wird mitgeteilt, dass die Ausreise vermutlich freiwillig erfolgt ist, da kein gesonderter Nachweis vorliegt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                        </xs:choice>
                     </xs:complexType>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="Asyl.Meldeanschrift.111205">
      <xs:annotation>
         <xs:appinfo>
            <autor>Ausländerbehörde (azr)</autor>
            <leser>Bundesamt für Migration und Flüchtlinge (dbs)</leser>
            <rechtsgrundlage>§ 54 AsylG</rechtsgrundlage>
            <title>Geänderte Meldeanschrift</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht wird eine geänderte Meldeanschrift von der zuständigen abh (ABH/ZAB) oder ae (AE) an das bamf übermittelt.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Asyl.Basisnachricht">
               <xs:sequence>
                  <xs:element name="person"
                              maxOccurs="unbounded"
                              type="xauslaender:Asyl.PersonGrunddatenMitAZRNummer">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element werden Daten der Personen übermittelt, für die eine geänderte Meldeanschrift übermittelt wird.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="alteMeldeanschrift" type="xima:Meldeanschrift">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird die bisherige Meldeanschrift übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="neueMeldeanschrift" type="xima:Meldeanschrift">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird die neue Meldeanschrift übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="Asyl.Zustaendigkeitserklaerung.111206">
      <xs:annotation>
         <xs:appinfo>
            <autor>Ausländerbehörde (azr)</autor>
            <leser>Bundesamt für Migration und Flüchtlinge (dbs)</leser>
            <rechtsgrundlage>§ 54 AsylG</rechtsgrundlage>
            <title>Geänderte Zuständigkeit</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht meldet eine abh (ABH/ZAB) ihre Zuständigkeit an das bamf.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Asyl.Basisnachricht">
               <xs:sequence>
                  <xs:element name="person"
                              maxOccurs="unbounded"
                              type="xauslaender:Asyl.PersonGrunddatenMitAZRNummer">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element werden die Grunddaten der Person übermittelt, für die von der abh die Zuständigkeit übernommen wurde.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="neueMeldeanschrift" minOccurs="0" type="xima:Meldeanschrift">
                     <xs:annotation>
                        <xs:documentation>Sofern im Zusammenhang mit dem Zuständigkeitswechsel eine neue Meldeanschrift vorliegt, wird sie mit diesem Element übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="Asyl.NichterscheinenInAeOderAbh.111207">
      <xs:annotation>
         <xs:appinfo>
            <autor>Aufnahmeeinrichtung (ane), Ausländerbehörde (azr)</autor>
            <leser>Bundesamt für Migration und Flüchtlinge (dbs)</leser>
            <rechtsgrundlage>§ 22 Abs. 3 S. 4 i.V.m. § 20 Abs. 2 S. 2 AsylG</rechtsgrundlage>
            <title>Nichterscheinen in AE oder ABH</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht teilt die nächstgelegene oder zuständige ae (AE) oder abh (ABH/ZAB) dem bamf mit, dass die Ausländer nach der Weiterleitung nicht erschienen sind. Dieses gilt sowohl für die erste Weiterleitung vor EASY- bzw. VilA-Verteilung als auch für die Weiterleitung nach EASY- bzw. VilA-Verteilung.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Nachricht.G2G.XA">
               <xs:sequence>
                  <xs:element name="person"
                              maxOccurs="unbounded"
                              type="xauslaender:Asyl.PersonGrunddatenMitAZRNummer">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element werden die Personengrunddaten des Ausländers übermittelt, der nicht in der ae bzw. abh (ABH/ZAB) erschienen ist.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="verteilungErfolgt" type="xs:boolean">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird angegeben, ob die Verteilung (EASY oder VILA) bereits erfolgt ist oder noch nicht.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="asylgesuch" type="xs:boolean">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird angegeben, ob ein Asylgesuch geäußert wurde (true) oder es sich um einen Aufgriff ohne Asylgesuch handelt (false)</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="anlagen"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xs:base64Binary">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird die Belehrung nach § 22 Abs. 3 AsylG übermittelt, falls von der vorhergehenden Behörde übersandt. Dies ist der Fall, wenn ein Asylgesuch gestellt wurde und die Verteilung erfolgt ist. Ggf. sind noch weitere individuelle Dokumente zu übermitteln.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="Asyl.RuecknahmeAsylantrag.111208">
      <xs:annotation>
         <xs:appinfo>
            <autor>Ausländerbehörde (azr), Aufnahmeeinrichtung (ane)</autor>
            <leser>Bundesamt für Migration und Flüchtlinge (dbs)</leser>
            <rechtsgrundlage>§§ 14 Abs. 2, 19 Abs. 1 AsylG</rechtsgrundlage>
            <title>Rücknahme eines Asylantrages</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht teilt die zuständige abh (ABH/ZAB) oder ae (AE) dem bamf mit, dass der Ausländer die Rücknahme des Asylantrages schriftlich erklärt hat.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Asyl.Basisnachricht">
               <xs:sequence>
                  <xs:element name="person"
                              maxOccurs="unbounded"
                              type="xauslaender:Asyl.PersonGrunddatenMitAZRNummer">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element werden Daten der Personen übermittelt, die unter einem BAMF-Aktenzeichen geführt werden und ihren Asylantrag zurückgenommen haben.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="schriftlicheRuecknahme" type="xs:base64Binary">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird die Kopie der vom Antragsteller oder den Antragstellenden unterschriebenen Bekundung der Rücknahme des Asylantrags übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="ruecknahmedatum" type="xida:Tagesdatum">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird das Datum der Rücknahme mitgeteilt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="grund">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird der Grund der Rücknahme des Asylantrags übermittelt.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:choice>
                           <xs:element name="grundDerRuecknahme" type="xauslaender:Code.Asyl.Ruecknahmegrund">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element wird der Grund der Rücknahme des Asylantrags übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="sonstigerGrund" type="din91379:datatypeC">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element wird der Grund der Rücknahme des Asylantrags übermittelt, sofern es sich nicht um eine freiwillige Ausreise oder die Erteilung eines Aufenthaltstitels handelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                        </xs:choice>
                     </xs:complexType>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="Asyl.FortzugNachUnbekannt.111209">
      <xs:annotation>
         <xs:appinfo>
            <autor>Ausländerbehörde (azr)</autor>
            <leser>Bundesamt für Migration und Flüchtlinge (dbs)</leser>
            <rechtsgrundlage>§ 54 Nr. 2 AsylG</rechtsgrundlage>
            <title>Fortzug nach Unbekannt</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht teilt die zuständige abh (ABH/ZAB) oder ae (AE) dem bamf mit, dass die Ausländer unter ihrer Meldeanschrift dauerhaft nicht erreichbar sind.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Asyl.Basisnachricht">
               <xs:sequence>
                  <xs:element name="person"
                              maxOccurs="unbounded"
                              type="xauslaender:Asyl.PersonGrunddatenMitAZRNummer">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element werden Daten der Person übermittelt, die unter einem BAMF-Aktenzeichen geführt wird.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="fortzugNachUnbekanntAm" type="xida:Tagesdatum">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird das Datum mitgeteilt, zu dem nach Kenntnis der Ausländerbehörde der Fortzug nach Unbekannt eingetreten ist (Siehe § 3 Abs. 1 Nummer 6 e) AZRG-DV).</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="Asyl.VerspaetetesErscheinenInAeOderAbh.111211">
      <xs:annotation>
         <xs:appinfo>
            <autor>Aufnahmeeinrichtung (ane)</autor>
            <leser>Bundesamt für Migration und Flüchtlinge (dbs)</leser>
            <rechtsgrundlage>§ 22 Abs. 3 i.V.m. § 20 Abs. 2 AsylG</rechtsgrundlage>
            <title>Verspätetes Erscheinen in AE oder ABH</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht teilt die zuständige ae (AE) oder abh (ABH/ZAB) dem bamf mit, dass die Ausländer nach bereits erfolgter Meldung über das Nichterscheinen nachricht.ref.111207 in der ae erschienen sind.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Nachricht.G2G.XA">
               <xs:sequence>
                  <xs:element name="person"
                              maxOccurs="unbounded"
                              type="xauslaender:Asyl.PersonGrunddatenMitAZRNummer">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element werden die Personengrunddaten des Ausländers übermittelt, der nicht in der ae erschienen ist.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="datum" type="xida:Tagesdatum">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird das Datum des Erscheinens in der zuständigen ae mitgeteilt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="Asyl.AnfrageAufhebungsverfahren.111401">
      <xs:annotation>
         <xs:appinfo>
            <autor>Ausländerbehörde (azr), Aufnahmeeinrichtung (ane)</autor>
            <leser>Bundesamt für Migration und Flüchtlinge (dbs)</leser>
            <rechtsgrundlage/>
            <title>Anfrage zur Einleitung des Aufhebungsverfahrens</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht kann die zuständige abh (ABH/ZAB) eine Anfrage zur Prüfung zur Aufnahme des Aufhebungsverfahrens an das bamf übermitteln.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Asyl.Basisnachricht">
               <xs:sequence>
                  <xs:element name="person"
                              maxOccurs="unbounded"
                              type="xauslaender:Asyl.PersonGrunddatenMitAZRNummer">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element werden Daten der Personen übermittelt, die unter einem BAMF-Aktenzeichen geführt werden und vom Inhalt dieser Nachricht betroffen sind.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="anlage"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xs:base64Binary">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element werden begründende Dokumente zur Anfrage der Einleitung des Aufhebungsverfahrens übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="grundAnfrageEinleitung"
                              maxOccurs="unbounded"
                              type="xauslaender:Code.Asyl.EinleitungAufhebungsverfahrenAnfragegrund">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird der Grund für die Anfrage der Einleitung des Aufhebungsverfahrens übermittelt.Es können hierbei mehrere unterschiedliche Sachverhalte gleichzeitig mitgeteilt werden.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="Asyl.AntwortPruefungEinleitungAufhebungsverfahren.111402">
      <xs:annotation>
         <xs:appinfo>
            <autor>Ausländerbehörde (azr), Aufnahmeeinrichtung (ane)</autor>
            <leser>Bundesamt für Migration und Flüchtlinge (dbs)</leser>
            <rechtsgrundlage/>
            <title>Antwort zur Prüfung zur Einleitung des Aufhebungsverfahrens</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht kann die zuständige abh (ABH/ZAB) eine Antwort zur Prüfung zur Einleitung des Aufhebungsverfahrens an das bamf übermitteln.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Asyl.Basisnachricht">
               <xs:sequence>
                  <xs:element name="personAuskunft" maxOccurs="unbounded">
                     <xs:annotation>
                        <xs:documentation>Das Element übermittelt Informationen von Personen, die vom BAMF im Rahmen des Aufhebungsverfahren angefragt wurden.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:sequence>
                           <xs:element name="person"
                                       maxOccurs="unbounded"
                                       type="xauslaender:Asyl.PersonGrunddatenMitAZRNummer">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element werden Daten der Personen übermittelt, die unter einem BAMF-Aktenzeichen geführt werden und vom Inhalt dieser Nachricht betroffen sind.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="informationZumAufhebungsverfahren">
                              <xs:complexType>
                                 <xs:choice>
                                    <xs:element name="eingebuergert" fixed="true" type="xs:boolean">
                                       <xs:annotation>
                                          <xs:documentation>Dieses Element ist zu übermitteln, wenn die betreffenden Personen eingebürgert wurden.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                    <xs:element name="verstorben" fixed="true" type="xs:boolean">
                                       <xs:annotation>
                                          <xs:documentation>Dieses Element ist zu übermitteln, wenn die betreffenden Personen verstorben sind.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                    <xs:element name="nichtzustaendigkeit">
                                       <xs:complexType>
                                          <xs:choice>
                                             <xs:element name="letztbekannteZustaendigeABH"
                                                         type="xauslaender:Code.Auslaenderbehoerde">
                                                <xs:annotation>
                                                   <xs:documentation>Dieses Element enthält das Behördenkennzeichen der letztbekannten zuständigen ABH.</xs:documentation>
                                                </xs:annotation>
                                             </xs:element>
                                             <xs:element name="insAusland" fixed="true" type="xs:boolean">
                                                <xs:annotation>
                                                   <xs:documentation>Dieses Element ist zu übermitteln, wenn die betreffenden Personen ins Ausland verzogen ist.</xs:documentation>
                                                </xs:annotation>
                                             </xs:element>
                                             <xs:element name="nachUnbekannt" fixed="true" type="xs:boolean">
                                                <xs:annotation>
                                                   <xs:documentation>Dieses Element ist zu übermitteln, wenn die betreffenden Personen unbekannt verzogen ist.</xs:documentation>
                                                </xs:annotation>
                                             </xs:element>
                                          </xs:choice>
                                       </xs:complexType>
                                    </xs:element>
                                    <xs:element name="informationBeiZustaendigkeit">
                                       <xs:complexType>
                                          <xs:sequence>
                                             <xs:element name="abschiebungBeiAufhebungGeplant"
                                                         minOccurs="0"
                                                         fixed="true"
                                                         type="xs:boolean">
                                                <xs:annotation>
                                                   <xs:documentation>Dieses Element ist zu übermitteln, wenn geplant ist, die betreffenden Personen bei Aufhebung abzuschieben.</xs:documentation>
                                                </xs:annotation>
                                             </xs:element>
                                             <xs:element name="anschrift" type="xima:Meldeanschrift">
                                                <xs:annotation>
                                                   <xs:documentation>Mit diesem Element wird die Anschrift des Ausländers übermittelt.</xs:documentation>
                                                </xs:annotation>
                                             </xs:element>
                                             <xs:element name="familiaereBindungen"
                                                         minOccurs="0"
                                                         maxOccurs="unbounded"
                                                         type="xauslaender:Asyl.PersonGrunddatenMitAZRNummer">
                                                <xs:annotation>
                                                   <xs:documentation>Mit diesem Element werden Daten zu zusätzlichen Personen mit familiärer Bindung übermittelt, die vom BAMF aus Sicht der ABH im Aufhebungsverfahren zu berücksichtigen sind (z. B. nachgeborene Kinder).</xs:documentation>
                                                </xs:annotation>
                                             </xs:element>
                                             <xs:element name="grundEinleitung"
                                                         minOccurs="0"
                                                         maxOccurs="unbounded"
                                                         type="xauslaender:Code.Asyl.EinleitungAufhebungsverfahrenAnfragegrund">
                                                <xs:annotation>
                                                   <xs:documentation>Mit diesem Element werden Gründe der Einleitung des Aufhebungsverfahrens aus Sicht der ABH übermittelt.Es können hierbei mehrere unterschiedliche Sachverhalte gleichzeitig mitgeteilt werden.</xs:documentation>
                                                </xs:annotation>
                                             </xs:element>
                                             <xs:element name="anlage"
                                                         minOccurs="0"
                                                         maxOccurs="unbounded"
                                                         type="xs:base64Binary">
                                                <xs:annotation>
                                                   <xs:documentation>Mit diesem Element werden begründende Dokumente zur Einleitung des Aufhebungsverfahrens übermittelt.</xs:documentation>
                                                </xs:annotation>
                                             </xs:element>
                                          </xs:sequence>
                                       </xs:complexType>
                                    </xs:element>
                                 </xs:choice>
                              </xs:complexType>
                           </xs:element>
                        </xs:sequence>
                     </xs:complexType>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="Asyl.EinzelfallinformationAnBAMF.111501">
      <xs:annotation>
         <xs:appinfo>
            <autor>Ausländerbehörde (azr), Aufnahmeeinrichtung (ane)</autor>
            <leser>Bundesamt für Migration und Flüchtlinge (dbs)</leser>
            <rechtsgrundlage/>
            <title>Einzelfallinformation an BAMF</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht kann die zuständige abh (ABH/ZAB) oder ae (AE) Informationen an das bamf übermitteln, welche nicht über eine der strukturierten anderen Nachrichten abgebildet werden.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Asyl.Basisnachricht">
               <xs:sequence>
                  <xs:element name="person"
                              maxOccurs="unbounded"
                              type="xauslaender:Asyl.PersonGrunddatenMitAZRNummer">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element werden Daten der Personen übermittelt, die unter einem BAMF-Aktenzeichen geführt werden und vom Inhalt dieser Nachricht betroffen sind.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="anlageEinzelfallinformation"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xauslaender:Asyl.DokumentUndBezeichnung">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird ein Dokument zum besonderen Einzelfall übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="betreff" type="din91379:datatypeC">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird das Thema des speziellen Einzelfalls übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="freitext" minOccurs="0" type="din91379:datatypeC">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element werden Informationen zu einem besonderen Einzelfall in Textform übermittelt, welche nicht über eine der strukturierten anderen Nachrichten abgebildet werden können.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="betrifftDublinUeberstellung"
                              minOccurs="0"
                              fixed="true"
                              type="xs:boolean">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird gekennzeichnet, dass die Nachricht an das Dublin-Überstellungsreferat gerichtet ist.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="Asyl.BestaetigungAnkunftInZustaendigkeitsbereichABH.111601">
      <xs:annotation>
         <xs:appinfo>
            <autor>Ausländerbehörde (azr) </autor>
            <leser>Bundesamt für Migration und Flüchtlinge (dbs)</leser>
            <rechtsgrundlage/>
            <title>Bestätigung der Ankunft im Zuständigkeitsbereich der ABH</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht wird dem bamf der (Wieder-)Zuzug / Ankunft der Asylsuchenden in den Zuständigkeitsbereich der ABH mitgeteilt.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Asyl.Basisnachricht">
               <xs:sequence>
                  <xs:element name="person"
                              maxOccurs="unbounded"
                              type="xauslaender:Asyl.PersonGrunddatenMitAZRNummer">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element werden Daten der Personen übermittelt, die unter einem BAMF-Aktenzeichen geführt werden.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="zuzugsdatum" type="xida:Tagesdatum">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird das Datum des (Wieder-)Zuzugs in den Zuständigkeitsbereich der ABH mitgeteilt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="Asyl.Terminvorschlag.111602">
      <xs:annotation>
         <xs:appinfo>
            <title>Terminvorschlag zur Überstellung im Dublin-Verfahren</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht wird dem bamf ein Terminvorschlag zur Überstellung im Rahmen des Dublin-Verfahrens mitgeteilt.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Asyl.BasisnachrichtAnBAMFMitAnsprechpartner">
               <xs:sequence>
                  <xs:element name="person"
                              maxOccurs="unbounded"
                              type="xauslaender:Asyl.PersonGrunddatenMitAZRNummer">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element werden Daten der Personen übermittelt, die unter einem BAMF-Aktenzeichen geführt werden.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="kontrollierteUeberstellung" type="xs:boolean">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird mitgeteilt, ob es sich um eine kontrollierte Überstellung (true) oder ob es sich um eine freiwillige Überstellung handelt (false)</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="ueberstellungAngekuendigt" type="xs:boolean">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird mitgeteilt, ob der Termin dem Antragsteller angekündigt worden ist.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="laissezPasserVorhanden" type="xs:boolean">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird mitgeteilt, ob von einem vorherigen Termin ein Reisedokument (Laissez-Passer) vorhanden ist.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="ueberstellungsdatum" type="xida:Tagesdatum">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird das Tagesdatum der Überstellung übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="ankunftszeit" type="xs:time">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird die voraussichtliche Ankunftsuhrzeit am Zielort übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="ueberstellungsart">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird die Überstellungsart ausgewählt (Land-, Fähr- oder Luftüberstellung).</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:choice>
                           <xs:element name="landueberstellung">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element wird mitgeteilt, dass es sich um eine Landüberstellung handelt.</xs:documentation>
                              </xs:annotation>
                              <xs:complexType>
                                 <xs:sequence>
                                    <xs:element name="abfahrzeit" minOccurs="0" type="xs:time">
                                       <xs:annotation>
                                          <xs:documentation>Mit diesem Element die Uhrzeit der Abfahrt übermittelt.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                    <xs:element name="grenzuebergang"
                                                type="xauslaender:Code.Asyl.ZielortLandSeeuberstellung">
                                       <xs:annotation>
                                          <xs:documentation>Mit diesem Element wird der Grenzübergang mitgeteilt, an dem die Überstellung stattfindet.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                 </xs:sequence>
                              </xs:complexType>
                           </xs:element>
                           <xs:element name="faehrueberstellung">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element werden Informationen zu einer Fährüberstellung übermittelt.</xs:documentation>
                              </xs:annotation>
                              <xs:complexType>
                                 <xs:sequence>
                                    <xs:element name="abfahrzeit" minOccurs="0" type="xs:time">
                                       <xs:annotation>
                                          <xs:documentation>Mit diesem Element die Uhrzeit der Abfahrt übermittelt.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                    <xs:element name="ankunftsort"
                                                type="xauslaender:Code.Asyl.ZielortLandSeeuberstellung">
                                       <xs:annotation>
                                          <xs:documentation>Mit diesem Element wird der Ankunftsort der Fähre übermittelt.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                    <xs:element name="abfahrtsort" type="xauslaender:Code.Asyl.AbfahrtsortFaehre">
                                       <xs:annotation>
                                          <xs:documentation>Mit diesem Element wird der Abfahrtsort der Fähre übermittelt.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                    <xs:element name="nameDerFaehre" type="din91379:datatypeC">
                                       <xs:annotation>
                                          <xs:documentation>Mit diesem Element wird der Name der Fähre übermittelt.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                 </xs:sequence>
                              </xs:complexType>
                           </xs:element>
                           <xs:element name="luftueberstellung">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element werden Informationen zu einer Luftüberstellung übermittelt.</xs:documentation>
                              </xs:annotation>
                              <xs:complexType>
                                 <xs:sequence>
                                    <xs:element name="abflugzeit" type="xs:time">
                                       <xs:annotation>
                                          <xs:documentation>Mit diesem Element wird die Abflugzeit des ersten bzw. alleinigen Flugs übermittelt.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                    <xs:element name="zielflughafen" type="xauslaender:Code.Asyl.ZielFlughafen">
                                       <xs:annotation>
                                          <xs:documentation>Mit diesem Element wird der Zielflughafen des letzten bzw. alleinigen Flugs übermittelt.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                    <xs:element name="abflugFlughafen" type="xauslaender:Code.Asyl.AbflugFlughafen">
                                       <xs:annotation>
                                          <xs:documentation>Mit diesem Element wird der Abflugflughafen des ersten bzw. alleinigen Flugs übermittelt.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                    <xs:element name="flugnummer" type="din91379:datatypeC">
                                       <xs:annotation>
                                          <xs:documentation>Mit diesem Element wird die Flugnummer des ersten bzw. alleinigen Flugs übermittelt.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                    <xs:element name="via" minOccurs="0" maxOccurs="2">
                                       <xs:annotation>
                                          <xs:documentation>Mit diesem Element wird der via-Flughafen, die An- und Abflugzeit am via-Flughafen und die Flugnummer des Anschlussfluges übermittelt.</xs:documentation>
                                       </xs:annotation>
                                       <xs:complexType>
                                          <xs:sequence>
                                             <xs:element name="viaFlughafen" type="din91379:datatypeC">
                                                <xs:annotation>
                                                   <xs:documentation>Mit diesem Element wird der Flughafen übermittelt, über den der Anschlussflug ausgeführt wird.</xs:documentation>
                                                </xs:annotation>
                                             </xs:element>
                                             <xs:element name="viaAnkunftszeit" type="xs:time">
                                                <xs:annotation>
                                                   <xs:documentation>Mit diesem Element wird die Ankunftszeit des Zubringerfluges übermittelt.</xs:documentation>
                                                </xs:annotation>
                                             </xs:element>
                                             <xs:element name="viaAbflugzeit" type="xs:time">
                                                <xs:annotation>
                                                   <xs:documentation>Mit diesem Element wird die Abflugzeit des Anschlussflugs übermittelt.</xs:documentation>
                                                </xs:annotation>
                                             </xs:element>
                                             <xs:element name="viaFlugnummer" type="din91379:datatypeC">
                                                <xs:annotation>
                                                   <xs:documentation>Mit diesem Element wird die Flugnummer des Anschlussflugs übermittelt.</xs:documentation>
                                                </xs:annotation>
                                             </xs:element>
                                          </xs:sequence>
                                       </xs:complexType>
                                    </xs:element>
                                 </xs:sequence>
                              </xs:complexType>
                           </xs:element>
                        </xs:choice>
                     </xs:complexType>
                  </xs:element>
                  <xs:element name="ueberstellungsrelevanteInformation"
                              minOccurs="0"
                              maxOccurs="unbounded">
                     <xs:complexType>
                        <xs:sequence>
                           <xs:element name="angabe"
                                       type="xauslaender:Code.Asyl.UeberstellungsrelevanteInformation">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element wird eine überstellungsrelevante Information übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="detaillierteAngabe" minOccurs="0" type="din91379:datatypeC">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element wird eine detaillierte Angabe übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                        </xs:sequence>
                     </xs:complexType>
                  </xs:element>
                  <xs:element name="empfaengerPhysischeUeberstellungsunterlagen" minOccurs="0">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element werden Informationen zur Behörde übermittelt, die die physischen Überstellungsunterlagen erhalten soll, wenn diese vom Autor der Nachricht abweicht.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:sequence>
                           <xs:element name="behoerdenname" type="din91379:datatypeC"/>
                           <xs:element name="organisationseinheit" minOccurs="0" type="din91379:datatypeC"/>
                           <xs:element name="erreichbarkeit"
                                       minOccurs="0"
                                       maxOccurs="unbounded"
                                       type="bn-uq-g2g:KommunikationType"/>
                           <xs:element name="anschrift"
                                       type="xipa:PostalischeInlandsanschrift.Gebaeudeanschrift"/>
                        </xs:sequence>
                     </xs:complexType>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="Asyl.KeinTerminvorschlagMoeglich.111603">
      <xs:annotation>
         <xs:appinfo>
            <title>Kein Terminvorschlag möglich im Dublin-Verfahren</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht wird dem bamf mitgeteilt, dass kein Terminvorschlag zur Überstellung im Rahmen des Dublin-Verfahrens möglich ist.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Asyl.BasisnachrichtAnBAMFMitAnsprechpartner">
               <xs:sequence>
                  <xs:element name="person"
                              maxOccurs="unbounded"
                              type="xauslaender:Asyl.PersonGrunddatenMitAZRNummer">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element werden Daten der Personen übermittelt, die unter einem BAMF-Aktenzeichen geführt werden.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="grund" type="xauslaender:Code.Asyl.GrundKeinTerminvorschlag">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird der Grund übermittelt, warum kein Terminvorschlag möglich ist.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="grundSonstiges" minOccurs="0" type="din91379:datatypeC">
                     <xs:annotation>
                        <xs:documentation>Dieses Element beschreibt den sonstigen Grund und wird übermittelt, wenn im Element grund sonstiges ausgewählt wurde.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="anlageGrund"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xs:base64Binary">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird ein Dokument zum Grund übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="Asyl.Ueberstellungsmitteilung.111604">
      <xs:annotation>
         <xs:appinfo>
            <title>Überstellungsmitteilung im Dublin-Verfahren</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht wird dem bamf mitgeteilt, ob die Überstellung im Rahmen des Dublin-Verfahrens erfolgreich war oder nicht.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Asyl.BasisnachrichtAnBAMFMitAnsprechpartner">
               <xs:sequence>
                  <xs:element name="person"
                              maxOccurs="unbounded"
                              type="xauslaender:Asyl.PersonGrunddatenMitAZRNummer">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element werden Daten der Personen übermittelt, die unter einem BAMF-Aktenzeichen geführt werden.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="ergebnisUeberstellung">
                     <xs:annotation>
                        <xs:documentation>Wenn die Überstellung erfolgreich war, wird das Element erfolgreich und im Falle einer gescheiterten Überstellung das Element gescheiterteUeberstellung übermittelt.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:choice>
                           <xs:element name="erfolgreich">
                              <xs:complexType>
                                 <xs:sequence>
                                    <xs:element name="datum" type="xida:Tagesdatum">
                                       <xs:annotation>
                                          <xs:documentation>Mit diesem Element wird das tatsächliche Überstellungsdatum nach erfolgreicher Überstellung übermittelt.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                 </xs:sequence>
                              </xs:complexType>
                           </xs:element>
                           <xs:element name="gescheitert">
                              <xs:complexType>
                                 <xs:sequence>
                                    <xs:element name="grundDerGescheitertenUeberstellung"
                                                type="xauslaender:Code.Asyl.GrundGescheiterteUeberstellung">
                                       <xs:annotation>
                                          <xs:documentation>Mit diesem Element wird der Grund der gescheiterten Überstellung übermittelt.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                    <xs:element name="detaillierteAngaben" minOccurs="0" type="din91379:datatypeC">
                                       <xs:annotation>
                                          <xs:documentation>Mit diesem Element werden detaillierte Angaben zur gescheiterten Überstellung übermittelt.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                 </xs:sequence>
                              </xs:complexType>
                           </xs:element>
                        </xs:choice>
                     </xs:complexType>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
</xs:schema>
