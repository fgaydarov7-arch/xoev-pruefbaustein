               <xs:sequence>
                  <xs:element name="dienststelle" minOccurs="0" type="din91379:datatypeC">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird die angefragte Dienststelle der BPOL übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="vorgangsnummer"
                              minOccurs="0"
                              type="xauslaender:BPOL.Vorgangsnummer">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird die Vorgangsnummer der BPOL übermittelt, auf die sich die Einzelfallinformation bezieht.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="betreff" type="din91379:datatypeC">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird übermittelt, um welche Angelegenheit es geht.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="identifikation" type="xauslaender:BPOL.IdentifikationPerson"/>
                  <xs:element name="anlageEinzelfallinformation"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xauslaender:BPOL.Dokument">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element werden Anlagen zum Einzelfall übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="freitext" minOccurs="0" type="din91379:datatypeC">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element werden Informationen zu einem besonderen Einzelfall in Textform übermittelt, welche nicht über eine der strukturierten anderen Nachrichten abgebildet werden können.</xs:documentation>
