   <xs:element name="VonERSST.BkaBestandskorrekturAntwort.140011">
      <xs:annotation>
         <xs:appinfo>
            <autor>Bundesverwaltungsamt (kein Präfix festgelegt)</autor>
            <leser>Kommunikationspartner der Erstregistrierungsschnittstelle (kein Präfix festgelegt)</leser>
            <rechtsgrundlage/>
            <title>Ergebnis der Bestandskorrektur</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht informiert das BVA darüber, dass die Korrektur der Bestände für erkennungsdienstliche Maßnahmen entgegengenommen wurde.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Nachricht.G2G.XA">
               <xs:sequence>
                  <xs:element name="hintergrundaktivitaeten"
                              type="xauslaender:ERSST.Hintergrundaktivitaet">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird über die durch das BVA angestoßenen Hintergrundaktivitäten informiert.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="hinweis"
                              minOccurs="0"
                              maxOccurs="unbounded"
                              type="xauslaender:ERSST.Hinweis">
                     <xs:annotation>
                        <xs:documentation>Mit dem Element wird ein Hinweis zu einer nur teilweise oder nicht erfolgreichen Registrierung übermittelt.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="AnERSST.BkaAktivitaetenAbruf.140012">
      <xs:annotation>
         <xs:appinfo>
            <autor>Kommunikationspartner der Erstregistrierungsschnittstelle (kein Präfix festgelegt)</autor>
            <leser>Bundesverwaltungsamt (kein Präfix festgelegt)</leser>
            <rechtsgrundlage/>
            <title>Abruf der BKA-ED-Aktivitäten</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht wird der Status erkennungsdienstlicher Maßnahmen in INPOL/AFIS und/oder EURODAC beim BVA abgefragt.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Nachricht.G2G.XA.AnERSST">
               <xs:sequence>
                  <xs:element name="bkaEdVorgangsreferenz"
                              maxOccurs="unbounded"
                              type="xauslaender:ERSST.BkaEdVorgangsreferenz">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird die eindeutige Referenz auf einen BKA-ED-Vorgang übermittelt, dessen Status abgefragt werden soll.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="VonERSST.BkaAktivitaeten.140013">
      <xs:annotation>
         <xs:appinfo>
            <autor>Bundesverwaltungsamt (kein Präfix festgelegt)</autor>
            <leser>Kommunikationspartner der Erstregistrierungsschnittstelle (kein Präfix festgelegt)</leser>
            <rechtsgrundlage/>
            <title>Ergebnis zur BKA-ED-Aktivitätenanfrage</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht übermittelt das BVA das Aktivitätenergebnis bzw. Fehler zu jeder angefragten BKA-ED-Vorgangsreferenz.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Nachricht.G2G.XA">
               <xs:sequence>
                  <xs:element name="ergebnis" maxOccurs="unbounded">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird das Aktivitätenergebnis bzw. ein Fehler zu der angefragten BKA-ED-Vorgangsreferenz übermittelt.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:sequence>
                           <xs:element name="bkaEdVorgangsreferenz"
                                       type="xauslaender:ERSST.BkaEdVorgangsreferenz">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element wird die Refenz auf den angefragten BKA-ED-Vorgang übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="fehler"
                                       minOccurs="0"
                                       maxOccurs="unbounded"
                                       type="xauslaender:AZR.Fehler">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element wird eine Fehlerrückmeldung zur angefragten BKA-ED-Vorgangsreferenz übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="eurodacBestandsbildungsstatus"
                                       type="xauslaender:Code.ERSST.Aktivitaetenstatus">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element wird der aktuelle Status der Bestandsbildung in EURODAC übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="eurodacRecherchestatus"
                                       type="xauslaender:Code.ERSST.Aktivitaetenstatus">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element wird der aktuelle Status der EURODAC-Auskunft übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="bkaENummer" minOccurs="0" type="din91379:datatypeC">
                              <xs:annotation>
                                 <xs:documentation>Diese Nummer kennzeichnet die erkennungsdienstliche Maßnahme im BKA.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="inpolAfisBestandsbildungsstatus"
                                       type="xauslaender:Code.ERSST.Aktivitaetenstatus">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element wird der aktuelle Status der Bestandsbildung in INPOL/AFIS übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="loeschstatus" type="xauslaender:Code.ERSST.Aktivitaetenstatus">
                              <xs:annotation>
                                 <xs:documentation>Dieses Element wird in der Antwort auf eine Bestandskorrektur verwendet. Es übermittelt den aktuellen Status der Löschung in dem jeweils angesprochenen Bestand (INPOL/AFIS, EURODAC, je nach der ursprünglichen Bestandsbildung).</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="eurodacTreffer" minOccurs="0" maxOccurs="unbounded">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element wird die EURODAC-Auskunft übermittelt.</xs:documentation>
                              </xs:annotation>
                              <xs:complexType>
                                 <xs:sequence>
                                    <xs:element name="datumAsylantragstellung"
                                                minOccurs="0"
                                                type="xida:TeilbekanntesDatumMitUnbekannt">
                                       <xs:annotation>
                                          <xs:documentation>Mit diesem Element wird das Datum der Asylantragstellung in einem anderen Mitgliedstaat übermittelt.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                    <xs:element name="datumVerlassenAblehnung"
                                                minOccurs="0"
                                                type="xida:TeilbekanntesDatumMitUnbekannt">
                                       <xs:annotation>
                                          <xs:documentation>Mit diesem Element wird das Datum der Ausreise aufgrund einer Ablehnung übermittelt.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                    <xs:element name="datumVerlassenEu"
                                                minOccurs="0"
                                                type="xida:TeilbekanntesDatumMitUnbekannt">
                                       <xs:annotation>
                                          <xs:documentation>Mit diesem Element wird das Datum der Ausreise ohne Ausreiseaufforderung aus dem Hoheitsgebiet der Mitgliedstaaten übermittelt.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                    <xs:element name="datumBewilligungSchutz"
                                                minOccurs="0"
                                                type="xida:TeilbekanntesDatumMitUnbekannt">
                                       <xs:annotation>
                                          <xs:documentation>Mit diesem Element wird das Datum der Bewilligung von internationalem Schutz übermittelt.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                    <xs:element name="datumEdMassnahme"
                                                minOccurs="0"
                                                type="xida:TeilbekanntesDatumMitUnbekannt">
                                       <xs:annotation>
                                          <xs:documentation>Mit diesem Element wird das Datum der Abnahme des Fingerabdruckes übermittelt.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                    <xs:element name="datumRueckueberstellung"
                                                minOccurs="0"
                                                type="xida:TeilbekanntesDatumMitUnbekannt">
                                       <xs:annotation>
                                          <xs:documentation>Mit diesem Element wird das Datum der Rücküberstellung übermittelt.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                    <xs:element name="datumUebernahmeVerfahren"
                                                minOccurs="0"
                                                type="xida:TeilbekanntesDatumMitUnbekannt">
                                       <xs:annotation>
                                          <xs:documentation>Mit diesem Element wird das Datum der freiwilligen Übernahme des Asylverfahrens übermittelt.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                    <xs:element name="eurodacnummer" type="xauslaender:ERSST.Eurodacnummer">
                                       <xs:annotation>
                                          <xs:documentation>Mit diesem Element wird die EURODAC-Nummer übermittelt.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                    <xs:element name="geschlecht" type="xauslaender:Geschlecht"/>
                                    <xs:element name="markierung" minOccurs="0" type="xs:boolean">
                                       <xs:annotation>
                                          <xs:documentation>Mit diesem Element wird mitgeteilt, ob einer Person internationaler Schutz in einem anderen Mitgliedstaat gewährt wurde. Die Angabe unterbleibt, wenn keine Informationen zur Gewährung internationalen Schutzes vorliegen.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                    <xs:element name="ortAntragstellung" minOccurs="0" type="din91379:datatypeC">
                                       <xs:annotation>
                                          <xs:documentation>Mit diesem Element wird der Ort der Asylantragstellung im Mitgliedstaat übermittelt.</xs:documentation>
                                       </xs:annotation>
                                    </xs:element>
                                    <xs:any minOccurs="0"
                                            maxOccurs="unbounded"
                                            namespace="http://www.osci.de/xauslaender2611/ersst-erweiterung"
                                            processContents="lax"/>
                                 </xs:sequence>
                              </xs:complexType>
                           </xs:element>
                           <xs:any minOccurs="0"
                                   maxOccurs="unbounded"
                                   namespace="http://www.osci.de/xauslaender2611/ersst-erweiterung"
                                   processContents="lax"/>
                        </xs:sequence>
                     </xs:complexType>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="AnERSST.AbgleichergebnisseUebersichtAbruf.140014">
      <xs:annotation>
         <xs:appinfo>
            <autor>Kommunikationspartner der Erstregistrierungsschnittstelle (kein Präfix festgelegt)</autor>
            <leser>Bundesverwaltungsamt (kein Präfix festgelegt)</leser>
            <rechtsgrundlage/>
            <title>Anfrage der Übersicht zu Abgleichergebnissen</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht an das BVA wird mit der AZR-Nummer das Vorliegen von Abgleichergebnissen angefragt.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Nachricht.G2G.XA.AnERSST">
               <xs:sequence>
                  <xs:element name="azrNummer" maxOccurs="unbounded" type="xiaz:AZRNummer">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird die AZR-Nummer übermittelt, für die ein Abgleichergebnis angefragt werden soll.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="VonERSST.AbgleichergebnisseUebersicht.140015">
      <xs:annotation>
         <xs:appinfo>
            <autor>Kommunikationspartner der Erstregistrierungsschnittstelle (kein Präfix festgelegt)</autor>
            <leser>Bundesverwaltungsamt (kein Präfix festgelegt)</leser>
            <rechtsgrundlage/>
            <title>Übersicht der Abgleichergebnisse</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht übermittelt das BVA zu den angefragten AZR-Nummern jeweils die Information über das Vorhandensein eines Abgleichergebnisses oder Fehlermeldung(en).</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Nachricht.G2G.XA">
               <xs:sequence>
                  <xs:element name="ergebnis" maxOccurs="unbounded">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird die Information über das Vorhandensein eines Abgleichergebnisses bzw. Fehlers zu einer angefragten AZR-Nummer übermittelt.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:sequence>
                           <xs:element name="azrNummer" type="xiaz:AZRNummer">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element wird die AZR-Nummer übermittelt, für die ein Abgleichergebnis angefragt wurde.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="ergebnisLiegtVor" minOccurs="0" type="xs:boolean">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element wird angegeben, ob ein Abgleichergebnis abgerufen werden kann.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="fehler"
                                       minOccurs="0"
                                       maxOccurs="unbounded"
                                       type="xauslaender:AZR.Fehler">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element wird eine Fehlerrückmeldung zur angefragten AZR-Nummer übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                        </xs:sequence>
                     </xs:complexType>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="AnERSST.AnkunftsnachweisDruckansichtAbruf.140016">
      <xs:annotation>
         <xs:appinfo>
            <autor>Kommunikationspartner der Erstregistrierungsschnittstelle (kein Präfix festgelegt)</autor>
            <leser>Bundesverwaltungsamt (kein Präfix festgelegt)</leser>
            <rechtsgrundlage/>
            <title>Abruf der Druckansicht für Ankunftsnachweis</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht wird eine Druckansicht für den Ankunftsnachweis angefordert.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Nachricht.G2G.XA.AnERSST">
               <xs:sequence>
                  <xs:element name="azrNummer" type="xiaz:AZRNummer">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird die AZR-Nummer übermittelt, für die ein Ankunftsnachweis angefragt werden soll.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="aknNummer" type="xauslaender:ERSST.AKNNummer"/>
                  <xs:element name="gueltigBis" type="xida:Tagesdatum">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird das Befristungsdatum übermittelt, das auf dem Ankunftsnachweis vermerkt werden soll.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="mitreisendesKind" minOccurs="0" maxOccurs="4">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird der vollständige Name eines mitreisenden Kindes übermittelt. Bei mehr als vier Kindern sind die vollständigen Namen der weiteren Kinder im Element amtlicherVermerk zu übermitteln.</xs:documentation>
                     </xs:annotation>
                     <xs:simpleType>
                        <xs:restriction base="din91379:datatypeC">
                           <xs:maxLength value="28"/>
                        </xs:restriction>
                     </xs:simpleType>
                  </xs:element>
                  <xs:element name="amtlicherVermerk" minOccurs="0" maxOccurs="8">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird jeweils eine Zeile eines amtlichen Vermerks übermittelt, die auf dem Ankunftsnachweis aufgedruckt werden soll.</xs:documentation>
                     </xs:annotation>
                     <xs:simpleType>
                        <xs:restriction base="din91379:datatypeC">
                           <xs:maxLength value="27"/>
                        </xs:restriction>
                     </xs:simpleType>
                  </xs:element>
                  <xs:element name="eigeneAngaben" type="xs:boolean">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird mitgeteilt, ob die ausländische Person die Angaben zum Zeitpunkt der Erzeugung des Ankunftsnachweises selbst gemacht hat.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="druckansicht" type="xauslaender:Code.ERSST.Druckansicht">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird mitgeteilt, ob die Außenseite, die Innenseite oder der Barcode des Ankunftsnachweises erzeugt werden sollen.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="gesichtsbild" minOccurs="0" type="xilb:Lichtbild">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird das Gesichtsbild übermittelt. Dieses muss beim Druck der Innenseite angegeben werden. Das Bild sollte genau 413 mal 531 Pixel groß sein. Größere Bilder sind zulässig, werden dann auf die genannte Größe verkleinert und dabei ggf. zugeschnitten. Das Gesichtsbild muss die Anforderungen der Ankunftsnachweisverordnung (Anlage 2 Abschnitt 2) bezüglich biometrischer Eigenschaften erfüllen (ICAO-Konformität). Dies wird vor dem Erzeugen des PDFs geprüft. Falls zu der Person kein Gesichtsbild mit den geforderten biometrischen Eigenschaften aufgenommen werden kann, ist das Kennzeichen gesichtsbildNichtBiometrisch zu setzen, um die automatische Prüfung zu übersteuern.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="gesichtsbildNichtBiometrisch" minOccurs="0" type="xs:boolean">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird mitgeteilt, dass die im Element gesichtsbild übermittelte Aufnahme nicht die geforderten biometrischen Eigenschaften aufweist. Somit wird die Prüfung übersteuert.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:any minOccurs="0"
                          maxOccurs="unbounded"
                          namespace="http://www.osci.de/xauslaender2611/ersst-erweiterung"
                          processContents="lax"/>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="VonERSST.AnkunftsnachweisDruckansicht.140017">
      <xs:annotation>
         <xs:appinfo>
            <autor>Bundesverwaltungsamt (kein Präfix festgelegt)</autor>
            <leser>Kommunikationspartner der Erstregistrierungsschnittstelle (kein Präfix festgelegt)</leser>
            <rechtsgrundlage/>
            <title>Druckansicht für Ankunftsnachweis</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht übermittelt das BVA die angeforderte Druckansicht für den Ankunftsnachweis.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Nachricht.G2G.XA">
               <xs:sequence>
                  <xs:element name="rueckgabe">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird eine Dokumentseite oder der Barcode für den Ankunftsnachweis übermittelt.</xs:documentation>
                     </xs:annotation>
                     <xs:complexType>
                        <xs:choice>
                           <xs:element name="dokumentseite" type="xs:base64Binary">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element wird ein PDF-Dokument für die Außen- oder Innenseite des Ankunftsnachweises übermittelt.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:element name="barcode" type="xs:base64Binary">
                              <xs:annotation>
                                 <xs:documentation>Mit diesem Element wird der Barcode für den Ankunftsnachweis übermittelt. Der erzeugte Barcode hat die folgenden Eigenschaften: Data Matrix Barcode JPEG Format Pixelgröße 202 x 202 (+/-5 Pixel) Ränder: 0 Pixel Auflösung: 72dpi und muss auf einer Fläche von 20,2 x 20,2 Millimeter gedruckt werden.</xs:documentation>
                              </xs:annotation>
                           </xs:element>
                           <xs:any minOccurs="0"
                                   maxOccurs="unbounded"
                                   namespace="http://www.osci.de/xauslaender2611/ersst-erweiterung"
                                   processContents="lax"/>
                        </xs:choice>
                     </xs:complexType>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="AnERSST.AfisBestandsanfrage.140018">
      <xs:annotation>
         <xs:appinfo>
            <autor>Kommunikationspartner der Erstregistrierungsschnittstelle (kein Präfix festgelegt)</autor>
            <leser>Bundesverwaltungsamt (kein Präfix festgelegt)</leser>
            <rechtsgrundlage/>
            <title>Anfrage an den AFIS-Bestand</title>
         </xs:appinfo>
         <xs:documentation>Mit dieser Nachricht wird angefragt, ob Fingerabrücke im AFIS-Bestand vorliegen.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xauslaender:Nachricht.G2G.XA.AnERSST">
               <xs:sequence>
                  <xs:element name="azrNummer" minOccurs="0" type="xiaz:AZRNummer">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird die AZR-Nummer übermittelt, für die Fingerabdrücke abgerufen werden sollen.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="bkaENummer" minOccurs="0" type="din91379:datatypeC">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird die E-Nummer übermittelt, für die Fingerabdrücke abgerufen werden sollen.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="rueckgabeformat" type="xauslaender:Code.ERSST.Rueckgabeformat">
                     <xs:annotation>
                        <xs:documentation>Mit diesem Element wird mitgeteilt, welches Rückgabeformat gewünscht ist.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:any minOccurs="0"
                          maxOccurs="unbounded"
                          namespace="http://www.osci.de/xauslaender2611/ersst-erweiterung"
                          processContents="lax"/>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="VonERSST.AfisBestandsanfrageAntwort.140019">
      <xs:annotation>
         <xs:appinfo>
