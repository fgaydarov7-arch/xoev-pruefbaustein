   <Annotation>
      <Description>
         <!--Metadaten entsprechend XÖV-Handbuch 2.0-->
         <xoev-cl:beschreibung>Eine unerlaubte Einreise liegt vor, wenn eine Einreise in die
            Bundesrepublik nicht im Rahmen einer regulären Ersteinreise erfolgt ist. Ein unerlaubter
            Aufenthalt liegt vor, wenn kein Aufenthaltstitel (mehr) besteht oder ein Asylverfahren
            erfolglos beendet wurde.</xoev-cl:beschreibung>
         <xoev-cl:datumgueltigkeitab>2018-09-01</xoev-cl:datumgueltigkeitab>
         <!--Metadaten entsprechend XÖV-Handbuch 2.1-->
         <xoev-cl-2:nameKurz>UnerlaubtEinreiseUndAufenthalt</xoev-cl-2:nameKurz>
